# Git
.git
.gitignore

# 后端构建/数据产物
backend/bin
backend/data
backend/*.db*
backend/**/*.exe
data/

# 前端依赖与产物（构建阶段重新生成）
frontend/node_modules
frontend/dist

# Flutter（CI 单独构建，不打进镜像）
mobile

# 文档/报告
*.md
.github
.claude

# 本地环境
.env
*.local

# 本地调试工作区（含浏览器 profile 凭据，绝不进 build context）
.tmp
tmp
dist
node_modules
mobile/flutter_*.log
mobile/*-build*.log

# jessibuca 摄像头播放器资源（GPL-3.0）：绝不进镜像。
# Dockerfile 里 `COPY frontend/ ./` 拷的是工作区而非 git 追踪内容，
# 所以即使 .gitignore 已排除，本地跑过 fetch-jessibuca.sh 仍会把它带进构建上下文 →
# 最终 go:embed 进二进制并随镜像分发，等于间接发布了 GPL 产物。这里是唯一的硬闸门。
frontend/public/jessibuca/jessibuca.js
frontend/public/jessibuca/decoder.js
frontend/public/jessibuca/decoder.wasm
