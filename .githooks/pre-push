#!/usr/bin/env bash
# pre-push：把回归拦在本地。仅对本次推送里改动的后端 Go 包跑 `go vet`+`go test -short`。
#
# 起因：b171568 把体积评分分档从「≤5% 即满分」细化（≤1%=98 / ≤5%=90），
# 却漏改 TestScoreBoundary 用例，本地积压十几个提交批量推送后才在 CI 暴露。
# CI 已跑全量 `go test ./... -race`，但本地不跑就攒着推 → 回归溜进远端。
# 本钩补本地这一环：改动到哪测到哪，几秒~几十秒。
#
# 旁路（需要快速迭代时）：
#   git push --no-verify           # 内建旁路
#   PTPATRONUS_SKIP_TESTS=1 git push
#
# 启用（每个 clone 一次性）：
#   git config core.hooksPath .githooks
set -uo pipefail

if [ "${PTPATRONUS_SKIP_TESTS:-0}" = "1" ]; then
  echo "〔pre-push〕PTPATRONUS_SKIP_TESTS=1，跳过。"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
BE="$ROOT/backend"
[ -f "$BE/go.mod" ] || exit 0

# pre-push stdin 每行：<local_ref> <local_sha> <remote_ref> <remote_sha>
ZERO=0000000000000000000000000000000000000000
have_go=0
all_pkgs=""
all_files=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # 删除分支
  base="$remote_sha"
  if [ "$base" = "$ZERO" ]; then
    base="$(git hash-object -t tree /dev/null)"    # 新分支：对比空树
  fi
  # 本次推送引入提交里、backend/ 下改动的 *.go
  files=$(git diff --name-only "$base" "$local_sha" -- backend/ 2>/dev/null | grep '\.go$' || true)
  [ -z "$files" ] && continue
  have_go=1
  # 文件 → 所属包目录（相对 backend/），再补成 ./ 前缀；去重
  dirs=$(printf '%s\n' "$files" \
    | sed 's|^backend/||' \
    | while read -r rel; do [ -n "$rel" ] && dirname "$rel"; done \
    | sed -e 's|^|./|' -e 's|^\./\.$|./|' \
    | sort -u)
  all_pkgs="$all_pkgs $dirs"
  all_files="$all_files
$files"
done

if [ "$have_go" = "0" ]; then
  echo "〔pre-push〕本次推送无后端 Go 改动，跳过。"
  exit 0
fi

cd "$BE"
pkgs=$(echo $all_pkgs | tr ' ' '\n' | sort -u | grep -v '^$' | tr '\n' ' ')

# 行数/列宽棘轮门禁（与 CI 同款脚本，秒级）：改动使文件超 400 行或超宽行数上涨
# 在本地就拦下，不用等 CI 全量跑完才发现。baseline 只许缩不许涨。
if ! bash "$ROOT/scripts/check_file_length.sh" check; then
  echo "✗ 行数/列宽门禁失败，推送中止。（修复：拆分文件；或收缩后 bash scripts/check_file_length.sh init 刷新 baseline）" >&2
  exit 1
fi

# gofmt：只查本次改动的 *.go。原钩子与 CI 都只跑 vet+test，格式无人管——FluxTorrent 适配
# （8f2444ac）就是带着错缩进合进来的，而 `case` 缩进错位恰好掩盖「case 挂错 switch 层级」
# 这类真问题，review 时也最难看出来。
gofmt_targets=$(printf '%s\n' "$all_files" | sed 's|^backend/||' | grep '\.go$' | sort -u | grep -v '^$')
if [ -n "$gofmt_targets" ]; then
  unformatted=$(gofmt -l $gofmt_targets 2>/dev/null || true)
  if [ -n "$unformatted" ]; then
    echo "✗ 改动的 Go 文件未通过 gofmt（修复：cd backend && gofmt -w 文件）：" >&2
    printf '   %s\n' $unformatted >&2
    exit 1
  fi
fi
echo "〔pre-push〕go vet + test 改动包：$pkgs"
if ! go vet $pkgs; then
  echo "✗ go vet 失败，推送中止。（旁路：git push --no-verify）" >&2
  exit 1
fi
if ! go test -short -timeout 10m $pkgs; then
  echo "✗ go test 失败，推送中止。（旁路：git push --no-verify）" >&2
  exit 1
fi
echo "〔pre-push〕✓ 通过"
exit 0
