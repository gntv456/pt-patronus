# 数据 / 构建产物
backend/bin/
backend/data/
backend/data-test/
backend/*.db*
*.db
dist/
!backend/internal/web/dist/
!backend/internal/web/dist/**
!sdk/typescript/dist/
!sdk/typescript/dist/**
# /data/：只忽略仓库根目录的数据目录（后端运行时数据）。
# 不写成 data/——无前导斜杠会匹配任意层级，曾把本地未跟踪的
# frontend/src/data/*.ts 也忽略掉，行数门禁（check_file_length.sh
# 扫工作区文件）漏扫误报 NEW OFFENDER。
/data/
node_modules/
frontend/dist/
mobile/.dart_tool/
**/build/
*.log
*.exe

# 环境
.env
*.local

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Playwright E2E：后端临时库 + 测试报告
frontend/e2e/.data/
frontend/e2e/.auth/
frontend/.auth/
frontend/test-results/
frontend/playwright-report/

# 调试产物
mobile/_dbg_*
# 性能采集产物（本地生成，不入库）
perf-results.json
perf-auth.json

# 本地调试 / 逆向分析产物（编译测试二进制、抓取页面、临时脚本与日志）
tmp/
.apk-analyze/
backend/.localtest/

# Python 字节码缓存
__pycache__/
*.py[cod]

# Claude 本地设置（个人授权，不进 git）
.claude/
.tmp-gocache/

# 本地调试工作区（浏览器 profile 含 Login Data/Cookies 等真实凭据，严禁入库）
.tmp/
**/node_modules/
**/oh_modules/
ohos/.hvigor/

# jessibuca 摄像头播放器资源（GPL-3.0，不随仓库/镜像分发）。
# 用 `bash scripts/fetch-jessibuca.sh` 拉取（幂等 + sha256 校验）。
# 只忽略三个二进制，保留 README.md 作为说明。
frontend/public/jessibuca/jessibuca.js
frontend/public/jessibuca/decoder.js
frontend/public/jessibuca/decoder.wasm
