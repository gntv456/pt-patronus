      ],
      "cross": {
        "mode": "custom"
      },
      "generateRequestConfig": {
        "__fn": true,
        "src": "(selectedOptions) => {\n        const params: Record<string, any> = {};\n        (selectedOptions as Array<number | string>).forEach((value) => {\n          params[value] = \"1\";\n        });\n        return { requestConfig: { params } };\n      }"
      }
    },
    {
      "name": "搜索类型",
      "key": "typ",
      "options": [
