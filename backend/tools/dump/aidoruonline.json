          "value": 3
        }
      ]
    }
  ],
  "search": {
    "requestConfig": {
      "url": "/get_ttable.php",
      "params": {
        "pcat": "Show+All",
        "typ": "name",
        "scat": "",
        "subbed": "",
        "fl": "",
        "resd": "",
        "p": 0,
        "searchstr": "",
        "deadlive": 0
      }
    },
    "keywordPath": "params.searchstr",
    "selectors": {
      "rows": {
        "selector": "tr.t-row"
      },
      "id": {
        "selector": [
          "a[href*='torrents-details.php?id=']:not([href*='#'])"
        ],
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => query.match(/torrents-details\\.php\\?id=(\\d+)/)![1]"
          }
        ]
      },
      "title": {
        "selector": [
          "a[href*='torrents-details.php?id=']:not([href*='#']) b"
        ]
      },
      "url": {
        "selector": [
          "a[href*='torrents-details.php?id=']:not([href*='#'])"
        ],
        "attr": "href"
      },
      "link": {
        "selector": [
          "a[href*='download.php?id=']"
        ],
        "attr": "href"
      },
      "time": {
        "selector": [
          "td.ttable_timestamp"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => parseValidTimeString(query, [\"MMddyy HH:mm:ss\"])"
          }
        ]
      },
      "size": {
        "selector": [
          "td.ttable_size"
        ],
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "author": {
        "selector": [
          "a[href*='account-details.php?id=']"
        ]
      },
      "seeders": {
        "selector": [
          "font[color='green'] > b"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "leechers": {
        "selector": [
          "font[color='#ff0000'] > b"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "completed": {
        "selector": [
          "font[color='black'] > b"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "comments": {
        "selector": [
          "a.comment-link"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "category": {
        "selector": [
          "a.category-link"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => query.split(\":\")[1].trim()"
          }
        ]
      },
      "tags": [
        {
          "name": "Free",
          "selector": "img[title='freeleech']",
          "color": "blue"
        },
        {
          "name": "sub",
          "selector": "img[title='subtitled']",
          "color": "orange"
        }
      ],
      "status": {
        "selector": ":self",
        "elementProcess": {
          "__fn": true,
          "src": "(element: any) => {\n          if (!element) return ETorrentStatus.unknown;\n          if (element.querySelector(\"td.ttable_seeding font[color='green']\")) {\n            return ETorrentStatus.seeding; // 做种!\n          }\n          if (element.querySelector(\"td.ttable_seeding font[color='#ff0000']\")) {\n            return ETorrentStatus.downloading; // 吸血!\n          }\n          if (element.querySelector(\"td.ttable_seeding font[color='black']\")) {\n            return ETorrentStatus.completed; // 撤种!\n          }\n          return ETorrentStatus.unknown;\n        }"
        }
      },
      "progress": {
        "selector": ":self",
        "elementProcess": {
          "__fn": true,
          "src": "(element: any) => {\n          if (!element) return ETorrentStatus.unknown;\n          if (\n            element.querySelector(\"td.ttable_seeding font[color='green']\") ||\n            element.querySelector(\"td.ttable_seeding font[color='black']\")\n          ) {\n            return 100;\n          }\n          return ETorrentStatus.unknown;\n        }"
        }
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "name",
      "joinTime"
    ],
    "selectors": {
      "id": {
        "selector": [
          "a[href*='member.php?action=profile']"
        ],
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => query.match(/uid=(\\d+)/)![1]"
          }
        ]
      },
      "name": {
        "selector": [
          "td.prof-lbl:contains('Username:') + td"
        ]
      },
      "joinTime": {
        "selector": [
          "td.prof-lbl:contains('Joined:') + td"
        ],
        "filters": [
          {
            "name": "parseTime"
          }
        ]
      },
      "uploaded": {
        "selector": [
          "td.prof-lbl:contains('Uploaded:') + td"
        ],
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "downloaded": {
        "selector": [
          "td.prof-lbl:contains('Downloaded:') + td"
        ],
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "levelName": {
        "selector": [
          "td.prof-lbl:contains('User Class:') + td"
        ]
      },
      "ratio": {
        "selector": [
          "td.prof-lbl:contains('Ratio:') + td"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => (query.trim() === \"---\" ? -1 : parseFloat(query))"
          }
        ]
      },
      "uploads": {
        "selector": [
          "td.prof-lbl:contains('Uploads:') + td"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "seeding": {
        "selector": [
          "span[id='seed-count']"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "seedingPage": {
        "selector": [
          "div[id='seed-search-stat']"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => parseInt(query?.match(/Page (\\d+) \\//)?.[1] ?? \"0\")"
          }
        ]
      },
      "bonus": {
        "text": "0"
      },
      "seedingSize": {
        "selector": ":self",
        "elementProcess": {
          "__fn": true,
          "src": "(element: any) => {\n          if (!element) return 0;\n          const tr_elements = element.querySelectorAll(\"tr\");\n\n          let sumSizes: number = 0;\n          tr_elements.forEach((tr: any) => {\n            // 获取当前 tr 下的所有 td\n            const tdElements = tr.querySelectorAll(\"td\");\n            // 第 4 个 td（索引 3）是文件大小\n            if (tdElements.length >= 4) {\n              const sixthTd = tdElements[3];\n              const sizeText = sixthTd.textContent?.trim() || \"\";\n              sumSizes += parseSizeString(sizeText.replace(/,/g, \"\"));\n            }\n          });\n\n          return sumSizes;\n        }"
        }
      }
    }
  },
  "list": [
    {
      "urlPattern": [
        "/(index.php|torrents-search.php)$"
      ]
    }
  ],
  "detail": {
    "urlPattern": [
      "/torrents-details\\.php\\?id=\\d+"
    ],
    "selectors": {
      "title": {
        "selector": [
          "div.myFrame td:contains('Name:') + td"
        ]
      },
      "id": {
        "selector": [
          "a[href*='download.php?id=']"
        ],
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => query.match(/id=(\\d+)/)![1]"
          }
        ]
      },
      "link": {
        "selector": [
          "a[href*='download.php?id=']"
        ],
        "attr": "href"
      }
    }
  },
