  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "skipNonLatinCharacters": true,
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "category": {
        "selector": ":self",
        "data": "categoryId",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => categoryMap[Number(query)]"
          }
        ]
      },
      "tags": [
        {
          "__raw": "SpreadElement",
          "src": "...SchemaMetadata.search!.selectors!.tags!"
        },
        {
          "name": "H&R",
          "selector": "*",
          "color": "red"
        }
      ]
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "id": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.id"
        ],
        "selector": {
          "__call": "userInfoTrans.id.map((x) => `span[title='${x}'] + span`)"
        }
      },
      "seedingSize": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.seedingSize"
        ],
        "selector": {
          "__call": "userInfoTrans.seedingSize.map((x) => `span[title='${x}'] + span`)"
        }
      },
      "joinTime": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.joinTime"
        ],
        "selector": {
          "__call": "userInfoTrans.joinTime.map((x) => `span[title='${x}'] + span`)"
        }
      },
      "averageSeedingTime": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.averageSeedingTime"
        ],
        "selector": {
          "__call": "userInfoTrans.averageSeedingTime.map((x) => `span[title='${x}'] + span`)"
        }
      },
      "lastAccessAt": {
        "selector": {
          "__call": "userInfoTrans.lastAccessAt.map((x) => `span[title='${x}'] + span`)"
        },
        "filters": [
          {
            "name": "parseTTL"
          }
        ]
      },
      "invites": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.invites"
        ],
        "selector": ".ratio-bar__invites"
      },
      "ratio": {
        "selector": "li.ratio-bar__ratio a:has( > i.fa-sync-alt)",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "uploads": {
        "selector": ".user-profile-card__meta-item  a[href*='/uploads']"
      }
    }
  },
