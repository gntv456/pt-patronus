{
  "version": 2,
  "id": "audionews",
  "name": "AudioNews",
  "aka": [
    "AN"
  ],
  "description": "AudioNews (AN) is a Private Torrent Tracker for AUDIO SOFTWARE / SAMPLES / ETC",
  "tags": [
    "软件",
    "0day",
    "素材",
    "学习",
    "音乐制作"
  ],
  "timezoneOffset": "-0700",
  "type": "private",
  "schema": "AbstractPrivateSite",
  "urls": [
    "https://audionews.org/"
  ],
  "category": [
    {
      "name": "类别",
      "key": "f",
      "keyPath": "data",
      "options": {
        "__call": "buildCategoryOptionsFromDict(categoryMap)"
      },
      "cross": {
        "mode": "brackets"
      }
    }
  ],
  "search": {
    "skipNonLatinCharacters": true,
    "keywordPath": "data.nm",
    "requestConfig": {
      "url": "/tracker.php",
      "method": "POST",
      "headers": {
        "\"Content-Type\"": "application/x-www-form-urlencoded"
      },
      "data": {
        "prev_allw": 1,
        "prev_a": 0,
        "prev_dla": 0,
        "prev_dlc": 0,
        "prev_dld": 0,
        "prev_dlw": 0,
        "prev_my": 0,
        "prev_new": 0,
        "prev_sd": 0,
        "prev_da": 1,
        "prev_dc": 0,
        "prev_df": 1,
        "prev_ds": 0,
        "pre_tor_type": 0,
        "prev_date_from": "",
        "prev_date_to": "",
        "prev_hide_rereg": 0,
        "o": 1,
        "s": 2,
        "df": 1,
        "da": 1,
        "pn": "",
        "submit": "Search"
      },
      "responseType": "document"
    },
    "advanceKeywordParams": {
      "imdb": false
    },
    "selectors": {
      "rows": {
        "selector": "table.tracker-table > tbody > tr.tracker-row:has(a[href*='/dl.php?id='])"
      },
      "time": {
        "selector": ":self",
        "data": "torDate",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "dd_MM_yyyy"
            ]
          }
        ]
      },
      "title": {
        "selector": "td a[href*='/viewtopic.php?t=']"
      },
      "url": {
        "selector": "td a[href*='/viewtopic.php?t=']",
        "attr": "href"
      },
      "id": {
        "selector": "td a[href*='/dl.php?id=']",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "link": {
        "selector": "td a[href*='/dl.php?id=']",
        "attr": "href"
      },
      "category": {
        "selector": "td a[href*='/tracker.php?f=']",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "f"
            ]
          },
          {
            "__fn": true,
            "src": "(query: number) => categoryMap[query]"
          }
        ]
      },
      "size": {
        "text": 0,
        "selector": [
          "td:contains( GB)",
          "td:contains( MB)",
          "td:contains( KB)",
          "td:contains( B)"
        ],
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "seeders": {
        "selector": "td[title='Seeders']"
      },
      "leechers": {
        "selector": "td[title='Leechers']"
      },
      "completed": {
        "selector": "td[title^='Replies:']"
      },
      "comments": {
        "text": 0,
        "selector": "span.tracker_topic_replies a"
      },
      "author": {
        "selector": "td a[href*='/tracker.php?pid=']"
      }
    }
  },
  "detail": {
    "urlPattern": [
      "/viewtopic\\.php\\?t=\\d+"
    ],
    "selectors": {
      "title": {
        "selector": "a.tt-text[href^='viewtopic.php?t=']"
      },
      "link": {
        "selector": "a[href^='dl.php?id=']",
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/index.php",
          "responseType": "document"
        },
        "selectors": {
          "id": {
            "selector": "a.user_photo[title='Your profile'] img",
            "attr": "alt"
          }
        }
      },
      {
        "requestConfig": {
          "url": "/profile.php",
          "params": {
            "mode": "viewprofile"
          },
          "responseType": "document"
        },
        "assertion": {
          "id": "params.u"
        },
        "selectors": {
          "name": {
            "selector": "#username"
          },
          "levelName": {
            "selector": "b#rank-name"
          },
          "joinTime": {
            "selector": "#user_regdate",
            "filters": [
              {
                "name": "parseTime"
              }
            ]
          },
          "lastAccessAt": {
            "selector": "#user_lastvisit",
            "filters": [
              {
                "name": "parseTime"
              }
            ]
          },
          "ratio": {
            "selector": "#bt_user_ratio > b",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "downloaded": {
            "selector": "td#u_down_total > span",
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "uploaded": {
            "selector": "td#u_up_total > span",
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "seeding": {
            "text": 0,
            "selector": "span.dls-cnt",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return query.match(/Seed: (\\d+)/)?.[1];\n              }"
              }
            ]
          },
          "uploads": {
            "text": 0,
            "selector": "span.dls-cnt",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return query.match(/Self: (\\d+)/)?.[1];\n              }"
              }
            ]
          },
          "bonus": {
            "text": "N/A"
          },
          "bonusPerHour": {
            "text": "N/A"
          }
        }
      }
    ]
  }
}