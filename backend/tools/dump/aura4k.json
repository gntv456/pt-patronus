{
  "__spread": [
    "SchemaMetadata"
  ],
  "id": "aura4k",
  "version": 1,
  "name": "Aura4k",
  "aka": [
    "A4K"
  ],
  "tags": [
    "综合"
  ],
  "timezoneOffset": "+0000",
  "type": "private",
  "schema": "Unit3D",
  "urls": [
    "https://aura4k.net/"
  ],
  "favicon": "https://aura4k.net/favicon.ico",
  "category": [
    {
      "name": "类别",
      "key": "categoryIds",
      "options": {
        "__call": "buildCategoryOptionsFromDict(categoryMap)"
      },
      "cross": {
        "mode": "brackets"
      }
    },
    {
      "__ref": "CategoryFree"
    }
  ],
  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "category": {
        "selector": ":self",
        "data": "categoryId",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => categoryMap[Number(query)]"
          }
        ]
      }
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "levelName": {
        "selector": [
          ".wow-badges .wow-badge:first-child",
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.selectors!.levelName?.selector ?? [])"
          }
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(el: Element) => el.getAttribute(\"title\") || el.textContent?.replace(/\\s+/g, \" \").trim()"
        }
      },
      "bonusPerHour": {
        "selector": [
          "main aside section > div:nth-child(2) > div:nth-child(4) > div",
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.selectors!.bonusPerHour?.selector ?? [])"
          }
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      }
    }
  },
  "levelRequirements": [
    {
