{
  "version": 1,
  "id": "bakabt",
  "name": "BakaBT",
  "aka": [
    "BBT"
  ],
  "description": "BakaBT is a Private site for the Anime Community",
  "tags": [
    "动漫"
  ],
  "timezoneOffset": "+0000",
  "type": "private",
  "schema": "AbstractPrivateSite",
  "urls": [
    "uggcf://onxnog.zr/"
  ],
  "category": [
    {
      "name": "类别",
      "key": "category",
      "options": {
        "__call": "buildCategoryOptionsFromDict(categoryMap)"
      },
      "cross": {
        "mode": "append",
        "key": "c"
      }
    },
    {
      "name": "成人内容",
      "key": "hentai",
      "notes": "请先在站点设置中启用 Browse -> Show adult content",
      "options": [
        {
          "name": "显示",
          "value": 1
        },
        {
          "name": "不显示",
          "value": 0
        }
      ]
    }
  ],
  "search": {
    "keywordPath": "params.q",
    "requestConfig": {
      "url": "/browse.php",
      "responseType": "document",
      "params": {
        "only": 0,
        "incomplete": 1,
        "lossless": 1,
        "hd": 1,
        "multiaudio": 1,
        "bonus": 1,
        "reorder": 1
      }
    },
    "advanceKeywordParams": {
      "imdb": false
    },
    "selectors": {
      "rows": {
        "selector": ".torrents tr.torrent, .torrents tr.torrent_alt",
        "filter": {
          "__fn": true,
          "src": "(rows: HTMLElement[] | null): HTMLElement[] | null => {\n          if (!Array.isArray(rows)) return rows;\n          return rows.filter((row) => {\n            if (row.classList.contains(\"torrent_alt\") && row.textContent === \"Alternative versions: \") {\n              return false;\n            }\n            return true;\n          });\n        }"
        }
      },
      "id": {
        "selector": [
          "a.title",
          "a.alt_title"
        ],
        "attr": "href",
        "filters": [
          {
            "name": "split",
            "args": [
              "/",
              2
            ]
          }
        ]
      },
      "title": {
        "selector": [
          "a.title",
          "a.alt_title"
        ],
        "filters": [
          {
            "name": "trim"
          }
        ]
      },
      "subTitle": {
        "selector": "span.tags"
      },
      "url": {
        "selector": ".peers a",
        "attr": "href"
      },
      "category": {
        "text": "stub",
        "selector": "span.torrent_icon",
        "attr": "title"
      },
      "time": {
        "selector": ":self",
        "elementProcess": {
          "__fn": true,
          "src": "(row: HTMLElement) => {\n          // 对有 data-timestamp 属性的行直接返回时间戳\n          if (row.dataset.timestamp) return parseInt(row.dataset.timestamp);\n\n          // 其它版本行自身没有 data-timestamp 属性，需从子元素中获取\n          const timeTd = row.querySelector(\".added\")! as HTMLElement;\n          const timeSpan = timeTd.querySelector(\"span.datetime\");\n          if (timeSpan) {\n            return parseInt((timeSpan as HTMLElement).dataset.timestamp!);\n          }\n\n          // 其它版本种子上传时间如为 today 或 yesterday，无法获取到时间戳，转为手动解析\n          const currentDate = new Date();\n          if (timeTd.textContent === \"yesterday\") {\n            currentDate.setDate(currentDate.getDate() - 1);\n          }\n          return currentDate.getTime();\n        }"
        }
      },
      "size": {
        "selector": ".size",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "completed": {
        "selector": ".peers:first",
        "filters": [
          {
            "name": "split",
            "args": [
              "/",
              0
            ]
          },
          {
            "name": "trim"
          }
        ]
      },
      "seeders": {
        "selector": ".peers a:nth-child(1)"
      },
      "leechers": {
        "selector": ".peers a:nth-child(2)"
      },
      "tags": [
        {
          "name": "Free",
          "selector": "span.freeleech"
        },
        {
          "name": "Bonus",
          "selector": "span.bonus",
          "color": "yellow"
        },
        {
          "name": "Incomplete",
          "selector": "span.incomplete",
          "color": "black"
        },
        {
          "name": "Hentai",
          "selector": "span.hentai",
          "color": "pink"
        }
      ]
    }
  },
  "detail": {
    "urlPattern": [
      {
        "__regex": "/\\/torrent\\/(\\d+)\\/([^/]+)$/"
      }
    ],
    "selectors": {
      "title": {
        "selector": "div.title"
      },
      "link": {
        "selector": ".download_link",
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/",
          "responseType": "document"
        },
        "selectors": {
          "id": {
            "selector": "a.username",
            "attr": "href",
            "filters": [
              {
                "name": "split",
                "args": [
                  "/",
                  2
                ]
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/bonus.php",
          "responseType": "document"
        },
        "selectors": {
          "bonusPerHour": {
            "selector": "b.success",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/user/$id$/",
          "responseType": "document"
        },
        "assertion": {
          "id": "url"
        },
        "selectors": {
          "name": {
            "selector": "a.username"
          },
          "levelName": {
            "selector": "h2 > span",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => query.match(/^\\((.+?) - (.+?)\\)$/)![2]"
              }
            ]
          },
          "messageCount": {
            "selector": "a[href='/inbox.php'] > strong",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "joinTime": {
            "selector": "td:contains('Join date') + td > span.datetime",
            "data": "timestamp",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => parseInt(query) * 1000"
              }
            ]
          },
          "lastAccessAt": {
            "selector": "td:contains('Last seen') + td > span.datetime",
            "data": "timestamp",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => parseInt(query) * 1000"
              }
            ]
          },
          "uploaded": {
            "selector": "td:contains('Uploaded') + td",
            "filters": [
              {
                "name": "split",
                "args": [
                  "-",
                  0
                ]
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "downloaded": {
            "selector": "td:contains('Downloaded') + td",
            "filters": [
              {
                "name": "split",
                "args": [
                  "-",
                  0
                ]
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "ratio": {
            "selector": "td:contains('Share ratio') + td > span",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                if (query === \"∞\") return -1; // Infinity 不能通过 sendMessage 传递，会导致无返回，使用 -1 替代，前端会自动处理的\n                const ratioStr = query.replace(/,/g, \"\");\n                return definedFilters.parseNumber(ratioStr);\n              }"
              }
            ]
          },
          "bonus": {
            "selector": "td:contains('Bonus Points') + td",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "uploads": {
            "selector": "li#uploaded_tab > a",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "seeding": {
            "selector": "li#active_tab > a",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "seedingSize": {
            "selector": "div#tab_content > div#active table.torrents > tbody",
            "elementProcess": {
              "__fn": true,
              "src": "(el: HTMLElement) => {\n              const trs = el.querySelectorAll(\"tr\");\n              let seedingSize = 0;\n              trs.forEach((tr) => {\n                const sizeTd = tr.querySelector(\"td.size\");\n                if (!sizeTd) return;\n                seedingSize += definedFilters.parseSize((sizeTd as HTMLElement).innerText);\n              });\n              return seedingSize;\n            }"
            }
          }
        }
      }
    ]
  },
  "levelRequirements": [
    {
      "id": 1,
      "name": "User"
    },
    {
      "id": 2,
      "name": "Power User",
      "seedingSize": "25GB",
      "downloaded": "25GB",
      "ratio": 0.5,
      "privilege": "View peer lists & report torrents; Access to RSS; Can make up to 5 torrent offers simultaneously."
    }
  ]
}