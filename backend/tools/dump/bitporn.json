        "elementProcess": {
          "__fn": true,
          "src": "(element: any) => {\n          if (!element) return 0;\n\n          // 查找所有span元素\n          const spans = element.querySelectorAll(\"a.torrent-keywords-badge\");\n\n          // 提取所有span元素中的文本内容\n          const allText = Array.from(spans)\n            .map((span: any) => (span.textContent || span.innerText || \"\").trim())\n            .filter((text) => text.length > 0)\n            .join(\", \");\n\n          return allText;\n        }"
        }
      }
