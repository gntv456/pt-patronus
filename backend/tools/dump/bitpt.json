          "seeding": {
            "selector": "a[href*='seedtype=seeding']",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const match = query.match(/(\\d+)个/);\n                return match ? parseInt(match[1]) : 0;\n              }"
              }
            ]
          },
          "seedingSize": {
            "selector": "a[href*='seedtype=seeding']",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const match = query.match(/共([\\d.]+ ?[TGMKZEP]?i?B)/);\n                return match ? match[1] : \"0\";\n              }"
              },
              {
                "name": "parseSize"
              }
            ]
          }
        }
      }
