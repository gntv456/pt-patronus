  "search": {
    "keywordPath": "params.s",
    "requestConfig": {
      "url": "/browse.php",
      "params": {
        "st": 2
      }
    },
    "selectors": {
      "rows": {
        "selector": "table.torrenttable > tbody > tr:has(a[href^='details.php?tid='])"
      },
      "category": {
        "selector": "a[href*='browse.php?c=']",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "c"
            ]
          },
          {
            "__fn": true,
            "src": "(v: string) => categoryMap[Number(v)] ?? v"
          }
        ]
      },
      "title": {
        "selector": "a[href^='details.php?tid=']",
        "elementProcess": {
          "__fn": true,
          "src": "(element) => {\n          // bitpt 的标题区有 3 种结构：\n          // 1. 未启用副标题：标题完全是 a 的纯文本\n          // 2. 启用副标题，中英同行：中英标题都在 span.t_t，说明在 span.t_t_d_n\n          // 3. 启用副标题，中英双行：英文在 span.t_t，中文在 span.t_t_c / span.t_t_c_c，说明在 span.t_t_d\n          const container = element.parentElement ?? element;\n          const titleNodes = Array.from(element.querySelectorAll(\"span.t_t\"))\n            .map((node) => (node as HTMLElement).innerText.trim())\n            .filter(Boolean);\n          const chineseTitle = Array.from(container.querySelectorAll(\"span.t_t_c, span.t_t_c_c\"))\n            .map((node) => (node as HTMLElement).innerText.trim())\n            .filter(Boolean)\n            .join(\" \");\n          const hasInlineSubTitle = !!container.querySelector(\"span.t_t_d_n\");\n          const hasSplitSubTitle = !!container.querySelector(\"span.t_t_d\");\n\n          // 情况 1：启用副标题，中英同行\n          // 两段标题都在 span.t_t 中，且通常已经自带 []\n          if (hasInlineSubTitle) {\n            return titleNodes.join(\"\");\n          }\n\n          // 情况 2：启用副标题，中英双行\n          // 英文标题在 span.t_t，中文标题在 span.t_t_c / span.t_t_c_c\n          if (hasSplitSubTitle) {\n            const englishTitle = titleNodes.join(\" \");\n            // 个别条目可能只有英文标题，此时直接回退为英文，不强行补出 [英文]\n            if (!chineseTitle) {\n              return englishTitle || (element.innerText ?? element.textContent ?? \"\").trim();\n            }\n\n            return [chineseTitle, englishTitle]\n              .filter(Boolean)\n              .map((text) => (/^\\[.*\\]$/.test(text) ? text : `[${text}]`))\n              .join(\"\");\n          }\n\n          // 情况 3：未启用副标题，标题完全是 a 的纯文本\n          return (element.innerText ?? element.textContent ?? \"\").trim();\n        }"
        }
      },
      "subTitle": {
        "selector": "> td:nth-child(2)",
        "elementProcess": {
          "__fn": true,
          "src": "(element) => {\n          return Array.from(element.querySelectorAll(\"span.t_t_d, span.t_t_d_n\"))\n            .map((node) => (node as HTMLElement).innerText.trim())\n            .filter(Boolean)\n            .join(\" \");\n        }"
        },
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) =>\n            q\n              .replace(/\\*\\*/g, \"\")\n              .replace(/^\\s*\\*\\s*|\\s*\\*\\s*$/g, \"\")\n              .trim()"
          }
        ]
      },
      "url": {
        "selector": "a[href^='details.php?tid=']",
        "attr": "href"
      },
      "id": {
        "selector": "a[href^='details.php?tid=']",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "tid"
            ]
          }
        ]
      },
      "link": {
        "selector": "a[href^='download.php?tid=']:not([href*='ssl'])",
        "attr": "href"
      },
      "size": {
        "selector": "> td:nth-child(4)",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => q.trim().replace(/([KMGTPEZ])$/i, \"$1B\")"
          },
          {
            "name": "parseSize"
          }
        ]
      },
      "seeders": {
        "selector": "> td:nth-child(5)",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "leechers": {
