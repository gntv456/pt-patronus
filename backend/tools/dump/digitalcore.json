{
  "__spread": [
    "SchemaMetadata"
  ],
  "id": "digitalcore",
  "version": 1,
  "name": "DigitalCore",
  "aka": [
    "DC",
    "DCC"
  ],
  "description": "In a world of sharing, people make the difference.",
  "tags": [
    "综合"
  ],
  "timezoneOffset": "+0200",
  "type": "private",
  "schema": "Rartracker",
  "urls": [
    "uggcf://qvtvgnypber.pyho/"
  ],
  "category": [
    {
      "name": "类别",
      "key": "categories",
      "options": {
        "__call": "buildCategoryOptionsFromDict(categoryMap)"
      },
      "cross": {
        "mode": "brackets"
      }
    },
    {
      "name": "促销状态",
      "key": "freeleech",
      "options": [
        {
          "name": "免费",
          "value": "true"
        },
        {
          "name": "非免费",
          "value": "false"
        }
      ]
    }
  ],
  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "requestConfig": {
      "__spread": [
        "SchemaMetadata.search!.requestConfig"
      ],
      "params": {
        "__spread": [
          "SchemaMetadata.search!.requestConfig!.params"
        ],
        "dead": true,
        "extendedDead": true,
        "page": "search",
        "sort": "created"
      }
    },
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "subTitle": {
        "selector": "tagline"
      },
      "completed": {
        "selector": "times_completed"
      },
      "category": {
        "selector": "category",
        "filters": [
          {
            "__fn": true,
            "src": "(catId: number) => categoryMap[catId]"
          }
        ]
      },
      "tags": [
        {
          "name": "Free",
          "selector": "frileech",
          "color": "blue"
        },
        {
          "name": "Pack",
          "selector": "pack",
          "color": "blue"
        },
        {
          "name": "P2P",
          "selector": "p2p",
          "color": "red"
        },
        {
          "name": "UNRAR",
          "selector": "unrar",
          "color": "red"
        },
        {
          "name": "3D",
          "selector": "3d",
          "color": "red"
        },
        {
          "name": "H&R",
          "selector": "locked",
          "color": "red"
        }
      ],
      "ext_imdb": {
        "selector": "imdbid2"
      }
    }
  },
  "list": [
    {
      "urlPattern": [
        {
          "__regex": "/\\/(alltorrents|movies|tvseries|games|music|apps|xxx|other|search)(\\?.*)?$/"
        }
      ],
      "mergeSearchSelectors": false,
      "selectors": {
        "time": {
          "selector": "td:nth-child(6)",
          "filters": [
            {
              "name": "parseTime"
            }
          ]
        },
        "size": {
          "selector": "td:nth-child(7)",
          "filters": [
            {
              "name": "parseSize"
            }
          ]
        },
        "completed": {
          "selector": "td:nth-child(8)",
          "filters": [
            {
              "name": "parseNumber"
            }
          ]
        },
        "seeders": {
          "selector": "td:nth-child(9)"
        },
        "leechers": {
          "selector": "td:nth-child(10)"
        },
        "__spread": [
          "commonDocumentSelectors"
        ]
      }
    },
    {
      "urlPattern": [
        "/toplists/torrents"
      ],
      "mergeSearchSelectors": false,
      "selectors": {
        "completed": {
          "selector": "td:nth-child(4)",
          "filters": [
            {
              "name": "parseNumber"
            }
          ]
        },
        "seeders": {
          "selector": "td:nth-child(5)"
        },
        "leechers": {
          "selector": "td:nth-child(6)"
        },
        "__spread": [
          "commonDocumentSelectors"
        ]
      }
    }
  ],
  "detail": {
    "urlPattern": [
      {
        "__regex": "/\\/torrent\\/\\d+\\/.*$/"
      }
    ],
    "selectors": {
      "id": {
        "selector": "torrent[viewing-torrent]",
        "attr": "viewing-torrent"
      },
      "title": {
        "selector": "div.ellipsis > span"
      },
      "link": {
        "selector": "div[ng-hide*='vm.torrent'] > a:nth-child(1)",
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "name",
      "joinTime"
    ],
    "process": [
      {
        "__spread": [
          "SchemaMetadata.userInfo!.process![0]"
        ],
        "selectors": {
          "__spread": [
            "SchemaMetadata.userInfo!.process![0].selectors"
          ],
          "uploads": {
            "selector": "user.mytorrents"
          },
          "seeding": {
            "selector": "user.myseeds"
          }
        }
      },
      {
        "__spread": [
          "SchemaMetadata.userInfo!.process![1]"
        ],
        "selectors": {
          "__spread": [
            "SchemaMetadata.userInfo!.process![1].selectors"
          ],
          "trueUploaded": {
            "selector": "uploaded_real"
          },
          "levelId": {
            "selector": "class"
          },
          "levelName": {
            "selector": "class",
            "filters": [
              {
                "__fn": true,
                "src": "(levelId: number) => levelIdMap[levelId]"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/api/v1/users/$id$/bonuslog",
          "responseType": "json"
        },
        "assertion": {
          "id": "url"
        },
        "selectors": {
          "bonusPerHour": {
            "selector": ":self",
            "filters": [
              {
                "__fn": true,
                "src": "(bonusLog: IDigitalCoreBonusLogResp) => {\n                const item = bonusLog.find((entry) => get(entry, \"msg\")?.includes(\"hourly\"));\n                if (!item) return 0;\n\n                const match = get(item, \"msg\")?.match(/\\[b\\](\\d+(\\.\\d+)?)p\\[\\/b\\]/);\n                const dailyBonus = match ? parseFloat(match[1]) : null;\n\n                // 返回的是一天总魔力值\n                return dailyBonus !== null ? dailyBonus / 24 : 0;\n              }"
              }
            ]
          }
        }
      }
    ]
  },
  "levelRequirements": [
    {
      "id": 0,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[0]"
      }
    },
    {
      "id": 10,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[10]"
      },
      "interval": "P14D",
      "uploaded": "50GB",
      "ratio": 1.05,
      "privilege": "Get access to the request system and the bonus system. Can upload (moderated) torrents"
    },
    {
      "id": 20,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[20]"
      },
      "interval": "P105D",
      "uploaded": "300GB",
      "ratio": 1.1,
      "privilege": "See all 'top' lists. See extended statistics. IP logging disabled. All IP logs are now cleared"
    },
    {
      "id": 30,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[30]"
      },
      "interval": "P210D",
      "uploaded": "1200GB",
      "ratio": 1.1,
      "privilege": "Get 3 request slots, 2 invites and above perks"
    },
    {
      "id": 31,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[31]"
      },
      "interval": "P500D",
      "uploaded": "5TB",
      "ratio": 20,
      "privilege": "Get 5 extra invites and 6 additional request slots. Can upload unmoderated torrents."
    },
    {
      "id": 32,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[32]"
      },
      "interval": "P730D",
      "uploaded": "20TB",
      "ratio": 20,
      "privilege": "Get 10 more extra invites and 10 additional request slots. Can upload unmoderated torrents."
    },
    {
      "id": 70,
      "name": {
        "__raw": "ElementAccessExpression",
        "src": "levelIdMap[70]"
      },
      "groupType": "vip"
    }
  ]
}