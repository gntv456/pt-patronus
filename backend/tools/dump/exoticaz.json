      "cross": false,
      "generateRequestConfig": {
        "__fn": true,
        "src": "(selectedCategories) => {\n        return { params: {} } as IAdvancedSearchRequestConfig;\n      }"
      }
    },
    {
      "name": "分类",
      "key": "category",
      "keyPath": "params",
      "options": {
        "__call": "Object.entries(categoryMap).map(([value, name]) => ({ name, value: Number(value) }))"
      },
      "cross": {
        "mode": "appendQuote"
      }
    },
    {
      "name": "分辨率",
      "key": "res",
      "keyPath": "params",
      "options": {
        "__call": "Object.entries(resolutionMap).map(([value, name]) => ({ name, value: Number(value) }))"
      },
      "cross": {
        "mode": "appendQuote"
      }
    },
    {
      "name": "促销",
      "key": "discount",
      "keyPath": "params",
      "options": {
        "__call": "Object.entries(avzNetDiscountMap).map(([value, name]) => ({ name, value: Number(value) }))"
      },
      "cross": {
        "mode": "appendQuote"
      }
    },
    {
      "name": "类型",
      "key": "type",
      "keyPath": "params",
      "options": [
