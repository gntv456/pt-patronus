{
  "version": 1,
  "id": "exttorrents",
  "name": "EXT Torrents",
  "description": "EXT Torrents is a Public torrent site for MOVIES / TV / GENERAL",
  "tags": [
    "综合"
  ],
  "timezoneOffset": "+0800",
  "type": "public",
  "urls": [
    "https://ext.to/",
    "https://search.extto.com/",
    "https://extranet.torrentbay.st/"
  ],
  "category": [
    {
      "name": "Category",
      "key": "cat",
      "options": {
        "__ref": "categoryOptions"
      },
      "generateRequestConfig": {
        "__fn": true,
        "src": "(selectedCategories) => {\n        const params: { cat?: string; sub_cat?: string } = {};\n        const idParts = (selectedCategories as string).split(\"|\");\n        params.cat = idParts[0];\n        if (idParts.length > 1) params.sub_cat = idParts[1];\n        return { requestConfig: { params } };\n      }"
      }
    }
  ],
  "search": {
    "keywordPath": "params.q",
    "requestConfig": {
      "url": "/browse/",
      "responseType": "document",
      "params": {
        "with_adult": 1,
        "sort": "age",
        "order": "desc"
      }
    },
    "advanceKeywordParams": {
      "imdb": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ keywords, requestConfig }) => {\n          delete requestConfig!.params.q;\n          set(requestConfig!, \"params.imdb_id\", keywords);\n          return requestConfig!;\n        }"
        }
      }
    },
    "requestConfigTransformer": {
      "__fn": true,
      "src": "({ requestConfig }) => {\n      if (!(requestConfig?.params.cat || requestConfig?.params.imdb_id || requestConfig?.params.q)) {\n        set(requestConfig!, \"params.age\", 0);\n      }\n      return requestConfig!;\n    }"
    },
    "selectors": {
      "rows": {
        "selector": "table.table-striped > tbody > tr"
      },
      "category": {
        "selector": [
          "td:nth-child(1) div div a:nth-child(3)",
          "td:nth-child(1) div div a:nth-child(2)"
        ],
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(uri: string) => categoryMap[uri]"
          }
        ]
      },
      "id": {
        "selector": "td:nth-child(1) div a",
        "attr": "href",
        "filters": [
          {
            "__ref": "parseId"
          }
        ]
      },
      "title": {
        "selector": "td:nth-child(1) div a"
      },
      "url": {
        "selector": "td:nth-child(1) div a",
        "attr": "href"
      },
      "size": {
        "selector": "span:contains('Size') + span",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "time": {
        "selector": "span:contains('Age') + span",
        "elementProcess": {
          "__fn": true,
          "src": "(el: Element) => {\n          if (el.textContent.match(/minute|hour/)) {\n            return parseTimeToLiveToDate(el.textContent);\n          }\n          return parseValidTimeString(el.getAttribute(\"title\")!, [\"dd MMMM yyyy\"]);\n        }"
        }
      },
      "seeders": {
        "selector": "span:contains('Seeds') + span"
      },
      "leechers": {
        "selector": "span:contains('Leechs') + span"
      },
      "comments": {
        "selector": "a.comments-torrents-btn"
      },
      "ext_imdb": {
        "selector": "a[href*='imdb_id=']",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "imdb_id"
            ]
          }
        ]
      }
    }
  },
  "detail": {
    "urlPattern": [
      {
        "__regex": "/-\\d+\\//"
      }
    ],
    "selectors": {
      "title": {
        "selector": "h1.card-title:first"
      },
      "link": {
        "text": "N/A"
      }
    }
  }
}