  "officialGroupPattern": [
    {
      "__regex": "/Play(HD|SD|WEB|TV)$/i"
    }
  ],
  "search": {
    "keywordPath": "params.search",
    "requestConfig": {
      "url": "/browse.php"
    },
    "advanceKeywordParams": {
      "imdb": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig: config }) => {\n          set(config!, \"params.searchin\", 1); // params \"&search_area=4\"\n          return config!;\n        }"
        }
      }
    },
    "selectors": {
      "rows": {
        "selector": ".torrentrow"
      },
      "link": {
        "__ref": "linkQuery"
      },
      "url": {
        "__spread": [
          "linkQuery"
        ],
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          },
          {
            "name": "prepend",
            "args": [
              "/details.php?id="
            ]
          }
        ]
      },
      "id": {
        "__spread": [
          "linkQuery"
        ],
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "title": {
        "selector": [
          "a[href*='details.php']:has(>b)"
        ],
        "attr": "title"
      },
      "subTitle": {
        "text": ""
      },
      "category": {
        "selector": [
          "div:nth-child(1) img[alt]"
        ],
        "attr": "alt"
      },
      "comments": {
        "selector": "div:nth-child(5)"
      },
      "time": {
        "selector": "div:nth-child(6)",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            const queryMatch = query.match(/(\\d{2}:\\d{2}:\\d{2})[\\s\\n]*(\\d{2}\\/\\d{2}\\/\\d{4})/);\n            if (queryMatch && queryMatch.length > 2) {\n              const [hours, minutes, seconds] = queryMatch[1].split(\":\");\n              const [day, month, year] = queryMatch[2].split(\"/\");\n              return parseValidTimeString(\n                `${year}-${month.padStart(2, \"0\")}-${day.padStart(2, \"0\")} ${hours}:${minutes}:${seconds}`,\n              );\n            }\n            return \"\";\n          }"
          }
        ]
      },
      "size": {
        "selector": "div:nth-child(7)",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "completed": {
        "selector": "div:nth-child(8)",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            return query.match(/(\\d+)/)![1];\n          }"
          }
        ]
      },
      "seeders": {
        "selector": "div:nth-child(9)"
      },
      "leechers": {
        "selector": "div:nth-child(10)"
      },
      "author": {
        "selector": "div:nth-child(11)"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "joinTime"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/index.php",
          "responseType": "document"
        },
        "selectors": {
          "id": {
            "selector": [
              ".statusbar a[href*='userdetails.php']:has(>span)"
            ],
            "attr": "href",
            "filters": [
              {
                "name": "querystring",
                "args": [
                  "id"
                ]
              }
            ]
          },
          "name": {
            "selector": [
              ".statusbar a[href*='userdetails.php'] span"
            ]
          },
          "messageCount": {
            "text": 0,
            "selector": ".statusbar a[href*='messages.php']",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string | number) => {\n                const queryMatch = String(query || \"\").match(/(\\d+)/); // query 有时会直接传入 0\n                return queryMatch && queryMatch.length >= 2 ? parseInt(queryMatch[1]) : 0;\n              }"
              }
            ]
          },
          "uploaded": {
            "selector": [
              "span:has(img[src*='uploaded'])"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/,/g, \"\").match(/(上[传傳]量|Uploaded).+?([\\d.]+ ?[ZEPTGMK]?i?B)/);\n                return queryMatch && queryMatch.length === 3 ? parseSizeString(queryMatch[2]) : 0;\n              }"
              }
            ]
          },
          "downloaded": {
            "selector": [
              "span:has(img[src*='downloaded'])"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/,/g, \"\").match(/(下[载載]量|Downloaded).+?([\\d.]+ ?[ZEPTGMK]?i?B)/);\n                return queryMatch && queryMatch.length === 3 ? parseSizeString(queryMatch[2]) : 0;\n              }"
              }
            ]
          },
          "bonus": {
            "selector": [
              ".statusbar a[href*='shop.php']"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return query ? parseFloat(query.replace(/[\\s,]/g, \"\")) : 0;\n              }"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/userdetails.php",
          "responseType": "document"
        },
        "assertion": {
          "id": "params.id"
        },
        "selectors": {
          "levelName": {
            "selector": [
              "td:contains('Class') + td"
            ]
          },
          "joinTime": {
            "selector": [
              "td:contains('Join'):contains('date') + td"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                query = query.split(\" (\")[0];\n                return parseValidTimeString(query);\n              }"
              }
            ]
          },
          "lastAccessAt": {
            "selector": [
              "td:contains('Last'):contains('seen') + td"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                query = query.split(\" (\")[0];\n                return parseValidTimeString(query);\n              }"
              }
            ]
          },
          "seeding": {
            "selector": [
              "td:contains('Seed'):contains('bonus') + td > div:first"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query?.match(\n                  /Seeding (\\d+) torrents with a total seed size of ([\\d.\\s,ZEPTGMKiB]+)\\./,\n                );\n                return queryMatch && queryMatch.length > 2 ? queryMatch[1] : 0;\n              }"
              }
            ]
          },
          "seedingSize": {
            "selector": [
              "td:contains('Seed'):contains('bonus') + td > div:first"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query?.match(\n                  /Seeding (\\d+) torrents with a total seed size of ([\\d.\\s,ZEPTGMKiB]+)\\./,\n                );\n                return queryMatch && queryMatch.length > 2 ? parseSizeString(queryMatch[2]) : \"0\";\n              }"
              }
            ]
          },
          "bonusPerHour": {
            "selector": [
              "td:contains('Seed'):contains('bonus') + td > div:nth-child(3)"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query?.match(/Total: ([\\d,.]+) FLCoins \\/ hour/);\n                return queryMatch && queryMatch.length > 1 ? parseFloat(queryMatch[1].replace(/,/, \"\")) : \"0\";\n              }"
              }
            ]
          }
        }
      }
    ]
  },
