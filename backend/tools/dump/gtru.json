      }
    }
  },
  "userInfo": {
    "process": [
      {
        "requestConfig": {
          "url": "/userdetails.php"
        },
        "selectors": {
          "seeding": {
            "selector": "#activeseed",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "bonus": {
            "selector": ".ud-stat-row:contains('Total Seed Bonus') .ud-stat-value",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "name": {
            "selector": ".ud-profile-name",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => (element.textContent || \"\").replace(/\\s+/g, \" \").trim()"
            }
          },
          "uploaded": {
            "selector": ".ud-stat-row:contains('Uploaded') .ud-stat-value",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.split(/\\s*\\[/)[0].trim()"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "downloaded": {
            "selector": ".ud-stat-row:contains('Downloaded') .ud-stat-value",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.split(/\\s*\\[/)[0].trim()"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "ratio": {
            "selector": ".ud-stat-row:contains('Share ratio') .ud-stat-value",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "levelName": {
            "selector": ".ud-profile-meta img[src*='/classes/']",
            "attr": "src",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => {\n                const match = q.match(/\\/([^/]+)\\.\\w+$/);\n                const key = match ? match[1].toLowerCase() : \"\";\n                const map: Record<string, string> = {\n                  user: \"User\",\n                  power: \"PowerUser\",\n                  vip: \"VIP\",\n                  mod: \"Moderator\",\n                  sysop: \"SysOp\",\n                  admin: \"Admin\",\n                };\n                return map[key] || key;\n              }"
              }
            ]
          },
          "joinTime": {
            "selector": ".ud-profile-meta span:has(i.fa-calendar-o)",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.replace(/\\s*\\(.*\\)\\s*$/, \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm:ss"
                ]
              }
            ]
          },
          "lastAccessAt": {
            "selector": ".ud-profile-meta span:has(i.fa-clock-o)",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.replace(/\\s*\\(.*\\)\\s*$/, \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm:ss"
                ]
              }
            ]
          },
          "uploads": {
            "selector": "#uploaded table.dc-torrent-table",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              return element.querySelectorAll(\"tbody tr\").length;\n            }"
            }
          },
          "seedingSize": {
            "selector": "#seeding table.dc-torrent-table",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              let total = 0;\n              const rows = element.querySelectorAll(\"tbody tr\");\n              rows.forEach((row) => {\n                const sizeTd = row.querySelectorAll(\"td\")[2];\n                if (sizeTd) {\n                  const text = (sizeTd.textContent || \"\")\n                    .replace(/\\s+/g, \" \")\n                    .replace(/([\\d.]+)\\s*([KMGTP]?i?B)/i, \"$1 $2\")\n                    .trim();\n                  total += parseSizeString(text);\n                }\n              });\n              return total;\n            }"
            }
          }
        }
      }
    ]
  },
