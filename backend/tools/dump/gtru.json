  "search": {
    "requestConfig": {
      "url": "/browse.php",
      "params": {
        "incldead": 1,
        "search": ""
      }
    },
    "keywordPath": "params.search",
    "selectors": {
      "rows": {
        "selector": "table.browse_result tr:has(div.browsedesc)"
      },
      "id": {
        "selector": "div.browsedesc > a[href*='details.php']",
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => q.match(/id=([a-f0-9]+)/)?.[1] ?? q"
          }
        ]
      },
      "title": {
        "selector": "div.browsedesc > a[href*='details.php'] b"
      },
      "url": {
        "selector": "div.browsedesc > a[href*='details.php']",
        "attr": "href"
      },
      "link": {
        "selector": "a.index[href*='download.php/']",
        "attr": "href"
      },
      "time": {
        "selector": "div.tadded",
        "elementProcess": {
          "__fn": true,
          "src": "(element: HTMLElement) => {\n          const parts: string[] = [];\n          element.childNodes.forEach((node) => {\n            if (node.nodeType === 3) {\n              const text = node.textContent?.trim();\n              if (text) parts.push(text);\n            }\n          });\n          return parts.length >= 2 ? `${parts[0]} ${parts[1]}` : parts[0] || \"\";\n        }"
        },
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "yyyy-MM-dd HH:mm:ss"
            ]
          }
        ]
      },
      "size": {
        "selector": "div.tsize",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "completed": {
        "selector": "div.tsnatch",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "seeders": {
        "selector": "td:has(div.tsnatch) + td",
        "elementProcess": {
          "__fn": true,
          "src": "(element: HTMLElement) => {\n          const text = element.textContent || \"\";\n          const match = text.match(/(\\d+)\\s*\\/\\s*\\d+/);\n          return match ? parseInt(match[1]) : 0;\n        }"
        }
      },
      "leechers": {
        "selector": "td:has(div.tsnatch) + td",
        "elementProcess": {
          "__fn": true,
          "src": "(element: HTMLElement) => {\n          const text = element.textContent || \"\";\n          const match = text.match(/\\d+\\s*\\/\\s*(\\d+)/);\n          return match ? parseInt(match[1]) : 0;\n        }"
        }
      },
      "category": {
        "selector": "img.browsemaincatpic",
        "attr": "alt"
      },
      "comments": {
        "selector": "div.tcomments",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      }
    }
  },
