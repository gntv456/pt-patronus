                "name": "parseSize"
              }
            ]
          },
          "downloaded": {
            "selector": "td:contains('Downloaded') + td",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.split(/\\s*\\[/)[0].trim()"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "ratio": {
            "selector": "td:contains('Share ratio') + td td:first",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "levelName": {
            "selector": "td:contains('Class') + td img",
            "attr": "src",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => {\n                const match = q.match(/\\/([^/]+)\\.\\w+$/);\n                const key = match ? match[1].toLowerCase() : \"\";\n                const map: Record<string, string> = {\n                  user: \"User\",\n                  power: \"PowerUser\",\n                  vip: \"VIP\",\n                  mod: \"Moderator\",\n                  sysop: \"SysOp\",\n                  admin: \"Admin\",\n                };\n                return map[key] || key;\n              }"
              }
            ]
          },
          "joinTime": {
            "selector": "td:contains('Join date') + td",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.replace(/\\s*\\(.*\\)\\s*$/, \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm:ss"
                ]
              }
            ]
          },
          "lastAccessAt": {
            "selector": "td:contains('Last seen') + td",
            "filters": [
              {
                "__fn": true,
                "src": "(q: string) => q.replace(/\\s*\\(.*\\)\\s*$/, \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm:ss"
                ]
              }
            ]
          },
          "uploads": {
            "selector": "div#UploadedTorrents table.table",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              const rows = element.querySelectorAll(\"tr:has(td)\");\n              return rows.length;\n            }"
            }
          },
          "seedingSize": {
            "selector": "div#SeedingTorrents table.table",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              let total = 0;\n              const rows = element.querySelectorAll(\"tr:has(td)\");\n              rows.forEach((row) => {\n                const sizeTd = row.querySelectorAll(\"td\")[2];\n                if (sizeTd) {\n                  const text = (sizeTd.textContent || \"\").replace(/\\s+/g, \" \").trim();\n                  total += parseSizeString(text);\n                }\n              });\n              return total;\n            }"
            }
          }
        }
      }
    ]
