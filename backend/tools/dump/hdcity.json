  "search": {
    "__spread": [
      "SchemaMetadata.search!"
    ],
    "keywordPath": "params.iwannaseethis",
    "requestConfig": {
      "url": "/pt",
      "params": {
        "notnewword": 1
      }
    },
    "selectors": {
      "rows": {
        "selector": ".mitem"
      },
      "link": {
        "__ref": "linkQuery"
      },
      "url": {
        "__spread": [
          "linkQuery"
        ],
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          },
          {
            "name": "prepend",
            "args": [
              "/t-"
            ]
          }
        ]
      },
      "id": {
        "__spread": [
          "linkQuery"
        ],
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "title": {
        "selector": [
          ".mtop a[href^='t-']"
        ]
      },
      "subTitle": {
        "selector": [
          ".mtitle a[href^='t-']"
        ]
      },
      "time": {
        "selector": "div[style='minfo']",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            return query ? parseValidTimeString(query.match(/(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/)![1]) : \"\";\n          }"
          }
        ]
      },
      "size": {
        "selector": ".mbottom .mbelement:nth-child(3)",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "author": {
        "selector": [
          "div[style='minfo'] > span"
        ],
        "elementProcess": {
          "__ref": "cleanUsername"
        }
      },
      "seeders": {
        "selector": ".mbottom a[href*='seeders']",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            return query ? query.match(/(\\d+)/)![1] : \"0\";\n          }"
          }
        ]
      },
      "leechers": {
        "selector": ".mbottom a[href*='leechers']",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            return query ? query.match(/(\\d+)/)![1] : \"0\";\n          }"
          }
        ]
      },
      "completed": {
        "selector": ".mbottom a[href*='viewsnatches']",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            return query ? query.match(/(\\d+)/)![1] : \"0\";\n          }"
          }
        ]
      },
      "tags": [
        {
          "__raw": "SpreadElement",
          "src": "...SchemaMetadata.search!.selectors!.tags!"
        }
      ]
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "pickLast": [
      "id",
      "joinTime"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/userdetails",
          "responseType": "document"
        },
        "fields": [
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.process?.[0]?.fields || [])"
          },
          "id",
          "joinTime",
          "invites"
        ],
        "selectors": {
          "__spread": [
            "SchemaMetadata.userInfo!.process?.[0]?.selectors"
          ],
          "id": {
            "selector": [
              "center .text_alt .text:contains('ID')"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return query.match(/(\\d+)/)![1];\n              }"
              }
            ]
          },
          "name": {
            "selector": [
              ".text_alt span[style]"
            ],
            "elementProcess": {
              "__ref": "cleanUsername"
            }
          },
          "messageCount": {
            "text": 0,
            "selector": "a[href*='messages']",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseInt(query.match(/(\\d+)/)![1]);\n              }"
              }
            ]
          },
          "uploaded": {
            "selector": [
              ".text_alt + br + div .text:nth-child(1)"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseSizeString(\n                  query.match(/(上传量|上傳量|Uploaded):\\s+([\\d.]+ [ZEPTGMK]i?B)/)?.[2]?.trim() ?? \"0\",\n                );\n              }"
              }
            ]
          },
          "downloaded": {
            "selector": [
              ".text_alt + br + div .text:nth-child(1)"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseSizeString(\n                  query.match(/(下载量|下載量|Downloaded):\\s+([\\d.\\s,ZEPTGMKiB]+)/)?.[2]?.trim() ?? \"0\",\n                );\n              }"
              }
            ]
          },
          "levelId": {
            "selector": [
              ".text_alt img[src*='class']:first"
            ],
            "attr": "src",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const match = query.match(/\\/class\\/(\\d+)\\.gif/);\n                return match ? parseInt(match[1]) - 1 : 0;\n              }"
              }
            ]
          },
          "levelName": {
            "selector": [
              ".text_alt img[src*='class']:first"
            ],
            "attr": "src",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const levelId = parseInt(query.match(/\\/class\\/(\\d+)\\.gif/)![1]) - 1;\n                return levelRequirements.find((x) => x.id === levelId)?.name ?? levelId;\n              }"
              }
            ]
          },
          "bonus": {
            "selector": [
              ".text_alt + br + div .text:nth-child(4)"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseFloat(query.match(/(魅力值|Karma Points)\\s+([\\d.]+)/)?.[2]?.trim() ?? \"0\");\n              }"
              }
            ]
          },
          "joinTime": {
            "selector": [
              ".text:contains('加入日期')",
              ".text:contains('Join date')"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseValidTimeString(query.match(/(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/)![1]);\n              }"
              }
            ]
          },
          "lastAccessAt": {
            "selector": [
              ".text:contains('最近动向')",
              ".text:contains('Last Action')"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                return parseValidTimeString(query.match(/(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2})/)![1]);\n              }"
              }
            ]
          },
          "invites": {
            "selector": [
              ".text:contains('邀请')",
              ".text:contains('Invites')",
              ".text:contains('Available')",
              "td:contains('邀请')",
              "td:contains('Invites')",
              "td:contains('Available')",
              "center .text_alt .text:contains('邀请')",
              "center .text_alt .text:contains('Invites')"
            ],
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                if (!query?.trim()) return 0;\n                try {\n                  // 匹配 \"Available: 5\" 格式\n                  const availableMatch = query.match(/Available:\\s*(\\d+)/i);\n                  if (availableMatch) return parseInt(availableMatch[1], 10) || 0;\n\n                  // 匹配纯数字\n                  const num = parseInt(query.match(/\\d+/)?.[0] || \"0\", 10);\n                  return isNaN(num) ? 0 : num;\n                } catch {\n                  return 0;\n                }\n              }"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/mybonus",
          "responseType": "document"
        },
        "selectors": {
          "bonusPerHour": {
            "selector": [
              "div:contains('你当前每小时能获取'):last",
              "div:contains('You are currently getting'):last",
              "div:contains('你當前每小時能獲取'):last"
            ],
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          }
        }
      }
    ]
  },
  "levelRequirements": {
    "__ref": "levelRequirements"
  }
}