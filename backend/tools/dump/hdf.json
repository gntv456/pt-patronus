{
  "__spread": [
    "SchemaMetadata"
  ],
  "version": 1,
  "id": "hdf",
  "name": "HD-Forever",
  "aka": [
    "HD-F",
    "HDF"
  ],
  "description": "HD-Forever (HD-F) is a FRENCH Private Torrent Tracker for HD MOVIES",
  "tags": [
    "法国"
  ],
  "timezoneOffset": "+0100",
  "type": "private",
  "schema": "Gazelle",
  "urls": [
    "uggcf://uqs.jbeyq/"
  ],
  "category": [
    {
      "name": "Catégorie",
      "key": "filter_cat",
      "options": [
        {
          "value": 1,
          "name": "Film"
        },
        {
          "value": 2,
          "name": "Film d'animation"
        },
        {
          "value": 3,
          "name": "Spectacle"
        },
        {
          "value": 4,
          "name": "Concert"
        },
        {
          "value": 5,
          "name": "Série"
        },
        {
          "value": 6,
          "name": "Série d'animation"
        },
        {
          "value": 7,
          "name": "Documentaire"
        }
      ],
      "cross": {
        "mode": "appendQuote"
      }
    },
    {
      "name": "Promotion",
      "key": "freetorrent",
      "options": [
        {
          "value": "0",
          "name": "Normal"
        },
        {
          "value": "1",
          "name": "Freeleech"
        },
        {
          "value": "2",
          "name": "Neutral"
        },
        {
          "value": "3",
          "name": "Freeleech ou Neutral"
        }
      ]
    }
  ],
  "search": {
    "__spread": [
      "SchemaMetadata.search!"
    ],
    "requestConfig": {
      "url": "/torrents.php",
      "responseType": "document",
      "params": {
        "action": "basic",
        "searchsubmit": 1
      }
    },
    "advanceKeywordParams": {
      "imdb": {
        "requestConfig": {
          "params": {
            "action": "advanced",
            "searchsubmit": 1
          }
        },
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig, keywords }) => {\n          requestConfig!.params.imdbid = keywords;\n          delete requestConfig!.params.searchstr;\n          return requestConfig!;\n        }"
        }
      },
      "tmdb": {
        "requestConfig": {
          "params": {
            "action": "advanced",
            "searchsubmit": 1
          }
        },
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig, keywords }) => {\n          requestConfig!.params.tmdbid = keywords;\n          delete requestConfig!.params.searchstr;\n          return requestConfig!;\n        }"
        }
      }
    },
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors!"
      ],
      "rows": {
        "selector": "table#torrent_table tr.torrent, table#torrent_table tr.group_torrent",
        "filter": {
          "__ref": "filterHdfTorrentRows"
        }
      },
      "title": {
        "selector": ":self",
        "elementProcess": {
          "__ref": "extractHdfTitle"
        }
      },
      "subTitle": {
        "selector": ".torrent_info",
        "filters": [
          {
            "__fn": true,
            "src": "(text: string) => text.replace(/\\s+/g, \" \").trim()"
          }
        ]
      },
      "url": {
        "selector": [
          "a[href*='torrentid=']",
          "a[href*='torrents.php?id=']"
        ],
        "attr": "href"
      },
      "time": {
        "selector": "td.nobr span.time[title]",
        "attr": "title",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "dd-MM-yyyy, HH:mm:ss"
            ]
          }
        ]
      },
      "size": {
        "selector": "td.number_column.nobr",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "completed": {
        "selector": "td.number_column:nth-last-child(3)",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "seeders": {
        "selector": "td.number_column:nth-last-child(2)",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "leechers": {
        "selector": "td.number_column:nth-last-child(1)",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "ext_imdb": {
        "selector": "a.db-link-copy[data-imdb-id]",
        "attr": "data-imdb-id",
        "filters": [
          {
            "name": "extImdbId"
          }
        ]
      },
      "category": {
        "selector": "td.cats_col div[class*='cats_']",
        "attr": "class",
        "filters": [
          {
            "__fn": true,
            "src": "(cat: string) => {\n            if (/cats_film(?!d)/.test(cat)) return \"Film\";\n            if (/cats_filmd/.test(cat)) return \"Film d'animation\";\n            if (/cats_spectacle/.test(cat)) return \"Spectacle\";\n            if (/cats_concert/.test(cat)) return \"Concert\";\n            if (/cats_série(?!d)/.test(cat)) return \"Série\";\n            if (/cats_séried/.test(cat)) return \"Série d'animation\";\n            if (/cats_documentaire/.test(cat)) return \"Documentaire\";\n            return \"\";\n          }"
          }
        ]
      },
      "tags": [
        {
          "selector": "strong.torrent_label.tl_free",
          "name": "Free",
          "color": "blue"
        },
        {
          "selector": "strong.torrent_label:contains('-25%')",
          "name": "-25%",
          "color": "green"
        },
        {
          "selector": "strong.torrent_label:contains('-50%')",
          "name": "-50%",
          "color": "green"
        },
        {
          "selector": "strong.torrent_label:contains('-75%')",
          "name": "-75%",
          "color": "green"
        }
      ]
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "process": [
      {
        "__raw": "SpreadElement",
        "src": "...(SchemaMetadata.userInfo!.process ?? []).map((step, index) =>\n        index === 1\n          ? {\n              ...step,\n              fields: [\n                ...(step.fields ?? []).filter((field) "
      },
      {
        "requestConfig": {
          "url": "/ajax.php",
          "params": {
            "action": "community_stats"
          },
          "responseType": "json"
        },
        "assertion": {
          "id": "params.userid"
        },
        "fields": [
          "seeding"
        ]
      }
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "name": {
        "selector": [
          "div.user-name-class span[class^='class_']",
          "h2 a[href*='user.php?id='] span",
          "a.username + strong a[href*='user.php'] span"
        ]
      },
      "uploaded": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li.tooltip:contains('Uploadé :')`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "trueUploaded": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li.tooltip:contains('Upload réel (tracker)')`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "downloaded": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li.tooltip:contains('Téléchargé :')`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "ratio": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li:contains('Ratio :'):not(:contains('Ratio requis')) span.tooltip`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "bonus": {
        "selector": [
          "#bonus_points_number_link span"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "bonusPerHour": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li:contains('Points par heure')`"
          }
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "levelName": {
        "selector": [
          {
            "__tpl": "`${personalBox} > li:contains('Rang :')`"
          }
        ],
        "filters": [
          {
            "name": "split",
            "args": [
              "Rang :",
              1
            ]
          },
          {
            "name": "trim"
          }
        ]
      },
      "joinTime": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li:contains('Inscription :') span.time.tooltip`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "dd-MM-yyyy, HH:mm:ss"
            ]
          }
        ]
      },
      "lastAccessAt": {
        "selector": [
          {
            "__tpl": "`${statsBox} > li:contains('Dernier vu :') span.time.tooltip`"
          }
        ],
        "attr": "title",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "dd-MM-yyyy, HH:mm:ss"
            ]
          }
        ]
      },
      "uploads": {
        "selector": [
          "#comm_upload"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "seedingSize": {
        "selector": [
          "#comm_seedsize span.tooltip"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => query.replace(/^[\\s\\S]*?:\\s*/, \"\")"
          },
          {
            "name": "parseSize"
          }
        ]
      },
      "seeding": {
        "selector": [
          "response.seeding",
          "response.community.seeding"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      },
      "hnrUnsatisfied": {
        "selector": [
          "#hnr_count_link span"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      }
    }
  },
  "levelRequirements": [
    {
      "id": 1,
      "name": "Novice",
      "privilege": "Can download, vote on applications, use advanced search, and access the top 10."
    },
    {
      "id": 2,
      "name": "Member",
      "interval": "P1W",
      "uploaded": "55GB",
      "privilege": "Can upload, send requests, create bookmarks, edit wiki pages, download multiple torrents at once, and reset own password/authkey."
    },
    {
      "id": 3,
      "name": "Elite",
      "uploaded": "1TiB",
      "ratio": 1,
      "privilege": "Can access torrents notification system, create collections and a personal collection, create polls in forums, view snatch torrent lists, add own torrents to recommendations, display tag aliases, change password, and add artists to any group."
    }
  ]
}