  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "subTitle": {
        "text": "",
        "selector": [
          "a[href*='hit'][title]",
          "a[href*='hit']:has(b)"
        ],
        "elementProcess": {
          "__call": "subTitleRemoveExtraElement([\"span.tags\"], true)"
        }
      },
      "progress": {
        "__ref": "selectorSearchProgress"
      },
      "status": {
        "__ref": "selectorSearchStatus"
      },
      "tags": [
        {
          "__raw": "SpreadElement",
          "src": "...SchemaMetadata.search!.selectors!.tags!"
        },
        {
          "__raw": "SpreadElement",
          "src": "...allTagSelectors"
        }
      ]
    }
  },
  "searchEntry": {
    "area_torrent": {
      "name": "种子区",
      "requestConfig": {
        "url": "/torrents.php"
      }
    },
    "area_live": {
      "name": "LIVE区",
      "enabled": false,
      "requestConfig": {
        "url": "/live.php"
      }
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors"
      ],
      "bonusPerHour": {
        "selector": [
          "td.text:has(>h1)"
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(element: any) => {\n          if (!element) return 0;\n\n          // 查找所有包含魔力值信息的div元素\n          const divs = element.querySelectorAll('div[align=\"center\"]');\n\n          // 将所有div的文本内容合并\n          const allText = Array.from(divs)\n            .map((div: any) => div.textContent || div.innerText || \"\")\n            .join(\" \");\n\n          const queryMatch = String(allText || \"\")\n            .replace(/,/g, \"\")\n            .match(/[\\d.]+/g);\n          if (!queryMatch) return 0;\n\n          // 如果匹配到10个数字，取第0、5、8位相加；否则只取第0位\n          const bonusPerHour =\n            queryMatch.length === 10\n              ? parseFloat(queryMatch[0]) + parseFloat(queryMatch[5]) + parseFloat(queryMatch[8])\n              : parseFloat(queryMatch[0]);\n          return bonusPerHour;\n        }"
        }
      }
    },
    "donorConfig": {
      "__spread": [
        "SchemaMetadata.userInfo!.donorConfig"
      ],
      "bonusPerHourMultiplier": 1
    }
  },
