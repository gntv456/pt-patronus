{
  "id": "myanonamouse",
  "version": 1,
  "name": "MyAnonamouse",
  "aka": [
    "MAM"
  ],
  "description": "Friendliness, Warmth and Sharing",
  "tags": [
    "电子书",
    "有声书"
  ],
  "timezoneOffset": "+0000",
  "type": "private",
  "schema": "TBDev",
  "urls": [
    "uggcf://jjj.zlnabanzbhfr.arg/"
  ],
  "category": [
    {
      "name": "主类别",
      "key": "tor[main_cat]",
      "options": [
        {
          "name": "Audiobooks",
          "value": 13
        },
        {
          "name": "E-Books",
          "value": 14
        },
        {
          "name": "Musicology",
          "value": 15
        },
        {
          "name": "Radio",
          "value": 16
        }
      ],
      "cross": {
        "mode": "brackets"
      }
    },
    {
      "name": "子类别",
      "key": "tor[cat]",
      "options": {
        "__ref": "categoryOptions"
      },
      "cross": {
        "mode": "brackets"
      }
    },
    {
      "name": "种子类型",
      "key": "tor[searchType]",
      "options": [
        {
          "name": "活种",
          "value": "active"
        },
        {
          "name": "死种",
          "value": "inactive"
        },
        {
          "name": "免费（含 VIP）",
          "value": "fl-VIP"
        },
        {
          "name": "免费（不含 VIP）",
          "value": "fl"
        },
        {
          "name": "VIP",
          "value": "VIP"
        },
        {
          "name": "非 VIP",
          "value": "nVIP"
        }
      ]
    }
  ],
  "search": {
    "keywordPath": "params.tor[text]",
    "requestConfig": {
      "url": "/tor/js/loadSearchJSONbasic.php",
      "responseType": "json",
      "params": {
        "\"tor[srchIn][title]\"": true,
        "\"tor[srchIn][author]\"": true,
        "\"tor[srchIn][narrator]\"": true,
        "\"tor[searchIn]\"": "torrents",
        "\"tor[cat][]\"": 0
      }
    },
    "advanceKeywordParams": {
      "imdb": false
    },
    "selectors": {
      "rows": {
        "selector": "data"
      },
      "id": {
        "selector": "id"
      },
      "title": {
        "selector": "title"
      },
      "subTitle": {
        "selector": "tags"
      },
      "url": {
        "selector": "id",
        "filters": [
          {
            "name": "prepend",
            "args": [
              "/t/"
            ]
          }
        ]
      },
      "link": {
        "selector": "id",
        "filters": [
          {
            "name": "prepend",
            "args": [
              "/tor/download.php?tid="
            ]
          }
        ]
      },
      "time": {
        "selector": "added"
      },
      "size": {
        "selector": "size"
      },
      "author": {
        "selector": "owner_name"
      },
      "category": {
        "selector": "catname"
      },
      "seeders": {
        "selector": "seeders"
      },
      "leechers": {
        "selector": "leechers"
      },
      "completed": {
        "selector": "times_completed"
      },
      "comments": {
        "selector": "comments"
      },
      "tags": [
        {
          "name": "Free",
          "selector": "free",
          "color": "blue"
        },
        {
          "name": "VIP",
          "selector": "fl_vip",
          "color": "yellow"
        },
        {
          "name": "H&R",
          "selector": "id",
          "color": "red"
        }
      ]
    }
  },
  "list": [
    {
      "urlPattern": [
        {
          "__regex": "/\\/tor\\/browse\\.php(\\?.*)?$/"
        }
      ],
      "mergeSearchSelectors": false,
      "selectors": {
        "rows": {
          "selector": "tr[id]"
        },
        "__spread": [
          "commonDocumentSelectors"
        ]
      }
    },
    {
      "urlPattern": [
        {
          "__regex": "/\\/stats\\/top10Tor\\.php(\\?.*)?$/"
        }
      ],
      "mergeSearchSelectors": false,
      "selectors": {
        "rows": {
          "selector": "table.newTorTable > tbody > tr"
        },
        "__spread": [
          "commonDocumentSelectors"
        ]
      }
    }
  ],
  "detail": {
    "urlPattern": [
      {
        "__regex": "/\\/t\\/\\d+(\\?.*)?$/"
      }
    ],
    "selectors": {
      "id": {
        "selector": "input[name=tid]",
        "attr": "value"
      },
      "title": {
        "selector": ".TorrentTitle"
      },
      "link": {
        "selector": "a.torFormButton",
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "name"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/jsonLoad.php?snatch_summary&notif",
          "responseType": "json"
        },
        "selectors": {
          "id": {
            "selector": "uid"
          },
          "name": {
            "selector": "username"
          },
          "ratio": {
            "selector": "ratio"
          },
          "bonus": {
            "selector": "seedbonus"
          },
          "uploaded": {
            "selector": "uploaded_bytes"
          },
          "downloaded": {
            "selector": "downloaded_bytes"
          },
          "levelName": {
            "selector": "classname"
          },
          "seeding": {
            "selector": ":self",
            "filters": [
              {
                "__fn": true,
                "src": "(loadResp: IMyAnonamouseLoadResp) => {\n                return seedingKeys.map((key) => loadResp[key].count).reduce((sum, count) => sum + count, 0);\n              }"
              }
            ]
          },
          "seedingSize": {
            "selector": ":self",
            "filters": [
              {
                "__fn": true,
                "src": "(loadResp: IMyAnonamouseLoadResp) => {\n                return seedingKeys.map((key) => loadResp[key].size ?? 0).reduce((sum, size) => sum + size, 0);\n              }"
              }
            ]
          },
          "uploads": {
            "selector": ":self",
            "filters": [
              {
                "__fn": true,
                "src": "(loadResp: IMyAnonamouseLoadResp) => {\n                return uploadKeys.map((key) => loadResp[key].count).reduce((sum, count) => sum + count, 0);\n              }"
              }
            ]
          },
          "messageCount": {
            "selector": "notifs",
            "filters": [
              {
                "__fn": true,
                "src": "(notifs: INotifs) => {\n                return Object.values(notifs).reduce((sum, val) => sum + val, 0);\n              }"
              }
            ]
          },
          "lastAccessAt": {
            "selector": "update",
            "filters": [
              {
                "__fn": true,
                "src": "(query: number) => query * 1000"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/u/$id$",
          "responseType": "document"
        },
        "assertion": {
          "id": "url"
        },
        "selectors": {
          "joinTime": {
            "selector": "td.rowhead:contains('Join'):contains('date') + td",
            "filters": [
              {
                "name": "split",
                "args": [
                  " (",
                  0
                ]
              },
              {
                "name": "parseTime"
              }
            ]
          },
          "trueDownloaded": {
            "selector": "td.rowhead:contains('Real Downloaded') + td",
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "trueUploaded": {
            "selector": "td.rowhead:contains('Real Uploaded') + td",
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "trueRatio": {
            "selector": "td.rowhead:contains('Real share ratio') + td",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "bonusPerHour": {
            "selector": "td.rowhead:contains('Points earning') + td",
            "elementProcess": {
              "__fn": true,
              "src": "(element: any) => {\n              if (!element || typeof element.innerText !== \"string\") return 0;\n              const match = element.innerText.match(/worth\\s+([\\d.]+)\\s+per hour/);\n              if (!match || !match[1]) return 0;\n              return parseFloat(match[1]);\n            }"
            }
          }
        }
      }
    ]
  },
  "levelRequirements": [
    {
      "id": 1,
      "name": "Mouse"
    },
    {
      "id": 2,
      "name": "User",
      "ratio": 1,
      "privilege": "Receive 1 request per month; Can have 50 unsatisfied torrents at maximum"
    },
    {
      "id": 3,
      "name": "Power User",
      "ratio": 2,
      "uploaded": "25GB",
      "interval": "P4W",
      "privilege": "Receive 2 requests per month; Can have 100 unsatisfied torrents at maximum"
    },
    {
      "id": 4,
      "name": "VIP",
      "groupType": "vip",
      "privilege": "Receive 4 requests per month; Can have 150 unsatisfied torrents at maximum"
    }
  ]
}