{
  "__spread": [
    "SchemaMetadata"
  ],
  "version": 1,
  "id": "passthepopcorn",
  "name": "PassThePopcorn",
  "aka": [
    "PTP"
  ],
  "description": "PassThePopcorn (PTP) is a Private site for MOVIES",
  "tags": [
    "电影"
  ],
  "timezoneOffset": "+0000",
  "collaborator": [
    "lengmianxia",
    "birdplane",
    "enigmaz"
  ],
  "type": "private",
  "schema": "Gazelle",
  "urls": [
    "https://passthepopcorn.me/"
  ],
  "category": [
    {
      "name": "Category",
      "key": "filter_cat",
      "options": [
        {
          "value": 1,
          "name": "Feature Film"
        },
        {
          "value": 2,
          "name": "Short Film"
        },
        {
          "value": 3,
          "name": "Miniseries"
        },
        {
          "value": 4,
          "name": "Stand-up Comedy"
        },
        {
          "value": 5,
          "name": "Live Performance"
        },
        {
          "value": 6,
          "name": "Movie Collection"
        }
      ],
      "cross": {
        "mode": "appendQuote"
      }
    },
    {
      "name": "Container",
      "key": "encoding",
      "options": {
        "__call": "buildCategoryOptionsFromList([\"AVI\", \"MPG\", \"MKV\", \"MP4\", \"VOB IFO\", \"ISO\", \"m2ts\"])"
      }
    },
    {
      "name": "Codec",
      "key": "format",
      "options": {
        "__call": "buildCategoryOptionsFromList([\n        [\"XviD\", \"DivX\", \"H.264\", \"x264\", \"H.265\", \"x265\"],\n        [\"DVD5\", \"DVD9\", \"BD25\", \"BD50\", \"BD66\", \"BD100\"],\n      ])"
      }
    },
    {
      "name": "Source",
      "key": "media",
      "options": {
        "__call": "buildCategoryOptionsFromList([\n        [\"CAM\", \"TS\", \"R5\", \"DVD-Screener\", \"VHS\", \"WEB\"],\n        [\"DVD\", \"TV\", \"HDTV\", \"HD-DVD\", \"Blu-ray\"],\n      ])"
      }
    },
    {
      "name": "Resolution",
      "key": "resolution",
      "options": [
        {
          "value": "anysd",
          "name": "Any SD"
        },
        {
          "value": "anyhd",
          "name": "Any HD"
        },
        {
          "value": "anyhdplus",
          "name": "Any HD+"
        },
        {
          "value": "anyuhd",
          "name": "Any UHD"
        },
        {
          "__raw": "SpreadElement",
          "src": "...buildCategoryOptionsFromList([\"NTSC\", \"PAL\", \"480p\", \"576p\", \"720p\", \"1080i\", \"1080p\", \"2160p\"])"
        }
      ]
    },
    {
      "name": "Release type",
      "key": "scene",
      "options": [
        {
          "value": "2",
          "name": "Golden Popcorn"
        },
        {
          "value": "3",
          "name": "Personal"
        },
        {
          "value": "4",
          "name": "Personal GP"
        },
        {
          "value": "0",
          "name": "Non-Scene"
        },
        {
          "value": "1",
          "name": "Scene"
        }
      ]
    },
    {
      "name": "Leech type",
      "key": "freetorrent",
      "options": [
        {
          "value": "0",
          "name": "Normal"
        },
        {
          "value": "1",
          "name": "Free"
        },
        {
          "value": "2",
          "name": "Half"
        },
        {
          "value": "3",
          "name": "Neutral"
        },
        {
          "value": "4",
          "name": "Any X-Leech"
        }
      ]
    }
  ],
  "search": {
    "__spread": [
      "SchemaMetadata.search!"
    ],
    "requestConfig": {
      "url": "/torrents.php",
      "responseType": "document",
      "params": {
        "noredirect": 1,
        "grouping": 0
      }
    },
    "selectors": {}
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/index.php",
          "responseType": "document"
        },
        "fields": [
          "id",
          "name",
          "messageCount"
        ]
      },
      {
        "requestConfig": {
          "url": "/user.php",
          "params": {},
          "responseType": "document"
        },
        "assertion": {
          "id": "params.id"
        },
        "fields": [
          "uploaded",
          "downloaded",
          "ratio",
          "levelName",
          "bonus",
          "bonusPerHour",
          "joinTime",
          "seeding",
          "seedingSize",
          "uploads"
        ]
      }
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "id": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.id!"
        ],
        "selector": [
          "a[href*='user.php?id=']:first"
        ]
      },
      "name": {
        "selector": [
          "a[href*='user.php?id=']:first"
        ]
      },
      "uploaded": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.uploaded!"
        ],
        "selector": "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Uploaded:')"
      },
      "downloaded": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.downloaded!"
        ],
        "selector": "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Downloaded:')"
      },
      "ratio": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.ratio!"
        ],
        "selector": "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Ratio:')"
      },
      "levelName": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.levelName!"
        ],
        "selector": "div.panel__heading:contains('Personal') + div.panel__body > ul.list > li:contains('Class:')"
      },
      "bonus": {
        "selector": "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Points:')",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            query = query.replace(/,/g, \"\");\n            const queryMatch = query.match(/Points.+?([\\d.]+)/);\n            return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : 0;\n          }"
          }
        ]
      },
      "bonusPerHour": {
        "selector": "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Points per hour:')",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            query = query.replace(/,/g, \"\");\n            const queryMatch = query.match(/Points per hour.+?([\\d.]+)/);\n            return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : 0;\n          }"
          }
        ]
      },
      "joinTime": {
        "selector": [
          "div.panel__heading:contains('Stats') + div.panel__body > ul.list > li:contains('Joined:') > span"
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(element: HTMLElement) => {\n          const query = (element.getAttribute(\"title\") || element.innerText).trim();\n          return parseValidTimeString(query, [\"MMM dd yyyy, HH:mm\"]);\n        }"
        }
      },
      "seeding": {
        "selector": [
          "div.panel__heading:contains('Community') + div.panel__body > ul.list > li:contains('Seeding:')"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            query = query.replace(/,/g, \"\");\n            const queryMatch = query.match(/Seeding.+?([\\d.]+)/);\n            return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : 0;\n          }"
          }
        ]
      },
      "seedingSize": {
        "selector": [
          "div.panel__heading:contains('Community') + div.panel__body > ul.list > li:contains('Seeding size:')"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            const queryMatch = query.replace(/,/g, \"\").match(/Seeding size.+?([\\d.]+ ?[ZEPTGMK]?i?B)/);\n            return queryMatch && queryMatch.length >= 2 ? parseSizeString(queryMatch[1]) : 0;\n          }"
          }
        ]
      },
      "uploads": {
        "selector": [
          "div.panel__heading:contains('Community') + div.panel__body > ul.list > li:contains('Uploaded:')"
        ],
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            const queryMatch = query.replace(/,/g, \"\").match(/Uploaded:.+?([\\d]+)/);\n            return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : 0;\n          }"
          }
        ]
      }
    }
  },
