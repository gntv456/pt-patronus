            "bSearchable_4": true,
            "iSortingCols": 1,
            "iSortCol_0": 0,
            "sSortDir_0": "asc",
            "bSortable_0": false,
            "bSortable_1": true,
            "bSortable_2": true,
            "bSortable_3": true,
            "bSortable_4": true,
            "userID": "PLACEHOLDER"
          }
        },
        "requestConfigTransformer": {
          "__fn": true,
          "src": "(config: any, lastUserInfo: any) => {\n          if (lastUserInfo && lastUserInfo.numericId) {\n            config.data.userID = lastUserInfo.numericId;\n          }\n          return config;\n        }"
        },
        "assertion": {
          "id": "userID"
        },
        "fields": [
          "uploads"
        ]
      }
    ],
    "selectors": {
      "id": {
        "selector": "#memberBar .span8 a[href*='/profile/']",
        "attr": "href",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => {\n          const match = q.match(/\\/profile\\/([^\\/]+)/);\n          return match ? match[1] : \"\";\n        }"
          }
        ]
      },
      "name": {
        "selector": "#memberBar .span8 a[href*='/profile/']"
      },
      "messageCount": {
        "selector": "a[href='/users/messages'] i.news-notify",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => parseInt(q) || 0"
          }
        ]
      },
      "uploaded": {
        "selector": "#profile button:has(.icon-arrow-up)",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => parseSizeString(q)"
          }
        ]
      },
      "downloaded": {
        "selector": "#profile button:has(.icon-arrow-down)",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => parseSizeString(q)"
          }
        ]
      },
      "levelName": {
        "selector": "#profileTable td:contains('Class') + td"
      },
      "joinTime": {
        "selector": "#profileTable td:contains('Join Date') + td",
        "filters": [
          {
            "__fn": true,
            "src": "(q: string) => {\n            const cleaned = q.replace(/(\\d+)(st|nd|rd|th)/, '$1');\n            return new Date(cleaned).getTime();\n          }"
          }
        ]
      },
      "numericId": {
        "selector": "a[href=\"#snatchlist\"][data-ajax=\"/user/account/snatchlist\"]",
        "attr": "data-userid"
      },
      "seeding": {
        "selector": "aaData",
        "filters": [
          {
            "__fn": true,
            "src": "(aaData: any) => {\n            if (!Array.isArray(aaData)) {\n              return 0;\n            }\n            return aaData.filter((data: any) => data[7] === 1 && data[8] === \"Yes\").length;\n          }"
          }
        ]
      },
      "seedingSize": {
        "selector": "aaData",
        "filters": [
          {
            "__fn": true,
            "src": "(aaData: any) => {\n            if (!Array.isArray(aaData)) return 0;\n            return aaData.reduce((total: number, data: any) => {\n              return data[7] === 1 && data[8] === \"Yes\" && data[1] ? total + parseSizeString(data[1]) : total;\n            }, 0);\n          }"
          }
        ]
      },
      "uploads": {
        "selector": "iTotalRecords",
        "filters": [
          {
            "__fn": true,
            "src": "(totalRecords: number) => totalRecords"
          }
        ]
      }
    }
  },
  "noLoginAssert": {
    "matchSelectors": [
      "div#loginContainer"
    ]
  }
}