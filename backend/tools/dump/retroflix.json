  "search": {
    "__spread": [
      "SchemaMetadata.search!"
    ],
    "requestConfig": {
      "url": "/browse",
      "params": {
        "includingDead": 1
      }
    },
    "advanceKeywordParams": {
      "imdb": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig: config }) => {\n          set(config!, \"params.searchIn\", 4);\n          return config!;\n        }"
        }
      }
    },
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors!"
      ],
      "rows": {
        "selector": "div.row > div.col-12 > div.row:gt(0)"
      },
      "url": {
        "__spread": [
          "SchemaMetadata.search!.selectors!.url!"
        ],
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          },
          {
            "name": "prepend",
            "args": [
              "/browse/t/"
            ]
          }
        ]
      },
      "title": {
        "selector": "a[href^='/browse/t/']"
      },
      "subTitle": {
        "selector": "div[data-content]:has(a[href^='/browse/t/'])",
        "elementProcess": {
          "__fn": true,
          "src": "(el: HTMLElement) => {\n          const props: string[] = [];\n\n          // 收集 props\n          Sizzle(\"a[href^='/browse/t/'] ~ a\", el).forEach((e) => props.push(e.textContent.trim()));\n\n          // 收集 genres\n          const genres: string[] = [];\n          Sizzle(\"div[class]:contains('Genre:') > a[href^='/browse']\", el).forEach((e) =>\n            genres.push(e.textContent.trim()),\n          );\n\n          // 合并 genres + props\n          const parts = [...genres, ...props].filter(Boolean);\n\n          // 如果都没有，返回空字符串\n          if (parts.length === 0) return \"\";\n\n          // 如果有 genres 才加 \"Genres: \"\n          const prefix = genres.length > 0 ? \"Genres: \" : \"\";\n\n          return prefix + parts.join(\" / \");\n        }"
        }
      },
      "comments": {
        "selector": "div.row > div:nth-child(1)"
      },
      "time": {
        "text": 0,
        "selector": "div.row > div:nth-child(2)",
        "elementProcess": {
          "__fn": true,
          "src": "(el: HTMLElement) => {\n          let time: number | string = 0;\n          try {\n            time = el.getAttribute(\"title\") || el.dataset.originalTitle || 0;\n            if (time) {\n              time = parseValidTimeString(time as string);\n            }\n          } catch (e) {}\n          return time;\n        }"
        }
      },
      "size": {
        "selector": "div.row > div:nth-child(3)",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "completed": {
        "selector": "div.row > div:nth-child(4)"
      },
      "seeders": {
        "selector": "div.row > div:nth-child(5)"
      },
      "leechers": {
        "selector": "div.row > div:nth-child(6)"
      },
      "author": {
        "selector": "div.row > div:nth-child(7)"
      }
    }
  },
  "list": [
    {
      "urlPattern": [
        "/browse"
      ],
      "excludeUrlPattern": [
        "/browse/t/"
      ]
    }
  ],
  "detail": {
    "urlPattern": [
      "/browse/t/"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.detail!.selectors!"
      ],
      "title": {
        "selector": "table h3"
      }
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/",
          "responseType": "document"
        },
        "fields": [
          "id"
        ]
      },
      {
        "requestConfig": {
          "url": "/userdetails.php",
          "responseType": "document"
        },
        "assertion": {
          "id": "params.id"
        },
        "fields": [
          "name",
          "messageCount",
          "uploaded",
          "trueUploaded",
          "downloaded",
          "trueDownloaded",
          "levelName",
          "bonus",
          "seedingBonus",
          "joinTime",
          "seeding",
          "seedingSize",
          "hnrUnsatisfied",
          "hnrPreWarning",
          "lastAccessAt"
        ]
      },
      {
        "requestConfig": {
          "url": "/mybonus.php",
          "responseType": "document"
        },
        "fields": [
          "bonusPerHour",
          "seedingBonusPerHour"
        ]
      }
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "seedingBonus": {
        "__ref": "undefined"
      },
      "joinTime": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.joinTime!"
        ],
        "filters": [
          {
            "name": "split",
            "args": [
              "(",
              0
            ]
          },
          {
            "name": "parseTime",
            "args": [
              "dd-MM-yyyy HH:mm:ss"
            ]
          }
        ]
      },
      "lastAccessAt": {
        "selector": "td.rowhead:contains('Last'):contains('seen') + td",
        "filters": [
          {
            "name": "split",
            "args": [
              "(",
              0
            ]
          },
          {
            "name": "parseTime",
            "args": [
              "dd-MM-yyyy HH:mm:ss"
            ]
          }
        ]
      },
      "averageSeedingTime": {
        "selector": "td.rowhead:contains('Seed avg.') + td",
        "filters": [
          {
            "name": "parseDuration"
          }
        ]
      },
      "hnrUnsatisfied": {
        "selector": "td.rowhead:contains('Need to Seed') + td",
        "filters": [
          {
            "name": "split",
            "args": [
              "(",
              0
            ]
          },
          {
            "name": "parseNumber"
          }
        ]
      }
    }
  },
