  "search": {
    "requestConfig": {
      "url": "/forum.php",
      "params": {
        "mod": "torrents"
      }
    },
    "keywordPath": "params.search",
    "advanceKeywordParams": {
      "imdb": false,
      "douban": false,
      "anidb": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig }) => {\n          if (requestConfig?.params?.search) {\n            requestConfig.params.search = \"$\" + requestConfig.params.search;\n          }\n\n          return requestConfig!;\n        }"
        }
      }
    },
    "selectors": {
      "rows": {
        "selector": "table.torrents > tbody > tr:gt(0)"
      },
      "id": {
        "selector": "a[href^=\"/forum.php?mod=viewthread\"]",
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "tid"
            ]
          }
        ]
      },
      "title": {
        "selector": "td.torrent_title > a[title]",
        "attr": "title"
      },
      "url": {
        "selector": "a[href^=\"/forum.php?mod=viewthread\"]",
        "attr": "href"
      },
      "link": {
        "selector": "a[href^=\"/download.php?id=\"]",
        "attr": "href"
      },
      "time": {
        "selector": " > td:nth-child(3)",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "yyyy-MM-dd HH:mm:ss",
              "yyyy-MM-dd\nHH:mm:ss"
            ]
          }
        ]
      },
      "size": {
        "selector": "> td:nth-child(4)",
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "author": {
        "selector": "> td:nth-last-child(1)"
      },
      "category": {
        "selector": "> td:nth-child(1)"
      },
      "seeders": {
        "selector": " > td:nth-child(5)"
      },
      "leechers": {
        "selector": " > td:nth-child(6)"
      },
      "completed": {
        "selector": " > td:nth-child(7)"
      },
      "comments": {
        "text": "N/A"
      },
      "ext_anidb": {
        "selector": "span[style=\"float:right;font-style:italic\"] > a[href*=\"torrents&search=%24\"]:nth-child(1)"
      },
      "progress": {
        "selector": [
          "div.tline1, div.tline2"
        ],
        "attr": "style",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => {\n            const queryMatch = query.match(/width:([ \\d.]+)%/);\n            return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : null;\n          }"
          }
        ]
      },
      "status": {
        "selector": ":self",
        "elementProcess": {
          "__fn": true,
          "src": "(tr: HTMLElement) => {\n          const statusAnothers = Sizzle(\"> td:eq(4), > td:eq(5), > td:eq(6)\", tr);\n          const statusStyle: (string | null)[] = statusAnothers.map((e) => e.getAttribute(\"style\"));\n          if (statusStyle[0]) {\n            return ETorrentStatus.seeding;\n          } else if (statusStyle[2]) {\n            return ETorrentStatus.completed;\n          } else if (statusStyle[1]) {\n            return ETorrentStatus.downloading;\n          } else {\n            return ETorrentStatus.unknown;\n          }\n        }"
        }
      }
    }
  },
  "list": [
    {
      "urlPattern": [
        {
          "__regex": "/\\/forum\\.php\\?mod=torrents/"
        }
      ]
    }
  ],
  "detail": {
    "urlPattern": [
      {
        "__regex": "/\\/forum\\.php\\?mod=viewthread/"
      }
    ],
    "selectors": {
      "title": {
        "selector": [
          "span#thread_subject"
        ]
      },
      "id": {
        "selector": [
          "div.pi a[href*=\"download.php?id=\"]"
        ],
        "attr": "href",
        "filters": [
          {
            "name": "querystring",
            "args": [
              "id"
            ]
          }
        ]
      },
      "link": {
        "selector": [
          "div.pi a[href*=\"download.php?id=\"][href*=\"&passkey=\"]",
          "div.pi a[href*=\"download.php?id=\"]"
        ],
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "name"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/"
        },
        "selectors": {
          "id": {
            "selector": ".vwmy a",
            "attr": "href",
            "filters": [
              {
                "name": "querystring",
                "args": [
                  "uid"
                ]
              }
            ]
          },
          "name": {
            "selector": ".vwmy a"
          },
          "messageCount": {
            "selector": [
              "a.a.showmenu.new"
            ],
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          }
        }
      },
      {
        "requestConfig": {
          "url": "/home.php",
          "params": {
            "mod": "space"
          }
        },
        "assertion": {
          "id": "params.uid"
        },
        "selectors": {
          "uploaded": {
            "selector": "#psts li:contains('上传量')",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/[\\s,]/g, \"\").match(/上传量.+\\/\\s*([\\d.]+[ZEPTGMK]?i?B)/i);\n                return queryMatch && queryMatch.length >= 2 ? queryMatch[1] : query;\n              }"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "downloaded": {
            "selector": "#psts li:contains('下载量')",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/[\\s,]/g, \"\").match(/下载量.+\\/\\s*([\\d.]+[ZEPTGMK]?i?B)/i);\n                return queryMatch && queryMatch.length >= 2 ? queryMatch[1] : query;\n              }"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "trueUploaded": {
            "selector": "#psts li:contains(\"实际上传\")",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/[\\s,]/g, \"\").match(/实际上传.+?([\\d.]+[ZEPTGMK]?i?B)/i);\n                return queryMatch && queryMatch.length >= 2 ? queryMatch[1] : query;\n              }"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "trueDownloaded": {
            "selector": "#psts li:contains(\"实际下载\")",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.replace(/[\\s,]/g, \"\").match(/实际下载.+\\/\\s*([\\d.]+[ZEPTGMK]?i?B)/i);\n                return queryMatch && queryMatch.length >= 2 ? queryMatch[1] : query;\n              }"
              },
              {
                "name": "parseSize"
              }
            ]
          },
          "levelName": {
            "selector": "a[href='home.php?mod=spacecp&ac=usergroup']",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => query.replace(\"用户组: \", \"\").trim()"
              }
            ]
          },
          "ratio": {
            "selector": "ul.bbda",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => {\n                const queryMatch = query.match(/分享率\\s*([\\d.]+)/);\n                return queryMatch && queryMatch.length >= 2 ? parseFloat(queryMatch[1]) : 0;\n              }"
              }
            ]
          },
          "bonus": {
            "selector": "#ratio",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "joinTime": {
            "selector": "#pbbs > li:contains('注册时间')",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => query.replace(\"注册时间\", \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm"
                ]
              }
            ]
          },
          "lastAccessAt": {
            "selector": "#pbbs > li:contains('最后访问')",
            "filters": [
              {
                "__fn": true,
                "src": "(query: string) => query.replace(\"最后访问\", \"\").trim()"
              },
              {
                "name": "parseTime",
                "args": [
                  "yyyy-MM-dd HH:mm"
                ]
              }
            ]
          }
        }
      }
    ]
  },
