          "color": "indigo"
        },
        {
          "name": "竞价置顶",
          "selector": ".tag.tag-sticky",
          "color": "yellow"
        },
        {
          "name": "加速中",
          "selector": ".tag.tag-speedup",
          "color": "pink"
        },
        {
          "name": "救活",
          "selector": ".tag.tag-reseed",
          "color": "indigo"
        }
      ]
    }
  },
  "list": [
    {
      "__raw": "SpreadElement",
      "src": "...SchemaMetadata.list!"
    },
    {
      "urlPattern": [
        "/speedup.php"
      ]
    }
  ],
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors"
      ],
      "uploaded": {
        "selector": [
          "td.rowhead:contains('上传量') + td"
        ],
        "filters": [
          {
            "name": "parseSize"
          }
        ]
      },
      "messageCount": {
        "__spread": [
          "SchemaMetadata.userInfo!.selectors!.messageCount"
        ],
        "selector": [
          "#msg-bar a[href*='messages.php'] strong"
        ]
      },
      "hnrPreWarning": {
        "text": 0,
        "selector": [
          "#info_block a[href*='hnr_details.php']:last"
        ],
        "filters": [
          {
            "name": "parseNumber"
          }
        ]
      }
    },
    "process": [
      {
        "__raw": "SpreadElement",
        "src": "...SchemaMetadata.userInfo!.process!.filter((item) => item.requestConfig.url !== \"/mybonus.php\")"
      },
      {
        "requestConfig": {
          "url": "/bonus.php",
          "params": {
            "show": "description"
          },
          "responseType": "document"
        },
        "fields": [
          "bonusPerHour"
        ]
      }
    ]
  },
