  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "advanceKeywordParams": {
      "__spread": [
        "SchemaMetadata.search!.advanceKeywordParams"
      ],
      "douban": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig: config }) => {\n          set(config!, \"params.search_area\", 5); // params \"&search_area=5\"\n          return config!;\n        }"
        }
      }
    },
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "rows": {
        "selector": "table.torrents:last > tbody > tr:gt(0):not(:last)"
      },
      "progress": {
        "__ref": "selectorSearchProgress"
      },
      "status": {
        "__ref": "selectorSearchStatus"
      },
      "tags": [
        {
          "name": "H&R",
          "selector": "*",
          "color": "red"
        },
        {
          "name": "禁转",
          "selector": ".tag.tag-exclusive",
          "color": "red"
        },
        {
          "name": "官方",
          "selector": ".tag.tag-tjupt",
          "color": "light-blue"
        },
