  "officialGroupPattern": [
    {
      "__regex": "/-(WiKi|DoA|.*TTG|NGB|ARiN)/i"
    }
  ],
  "search": {
    "keywordPath": "params.search_field",
    "requestConfig": {
      "url": "/browse.php",
      "params": {
        "c": "M"
      }
    },
    "advanceKeywordParams": {
      "imdb": {
        "requestConfigTransformer": {
          "__fn": true,
          "src": "({ requestConfig }) => {\n          if (requestConfig?.params?.search_field) {\n            requestConfig.params.search_field = requestConfig.params.search_field.replace(\"tt\", \"IMDB\");\n          }\n\n          return requestConfig!;\n        }"
        }
      }
    },
    "requestConfigTransformer": {
      "__fn": true,
      "src": "({ requestConfig }) => {\n      // 防止搜索字段缺失（如空白搜索的情况）\n      if (typeof requestConfig?.params?.search_field === \"undefined\") {\n        set(requestConfig!, \"params.search_field\", \"\");\n      }\n\n      // 在这里处理虚拟的 cat_movie 和 cat_game\n      if (requestConfig?.params?.c === \"M\" && requestConfig?.params?.cat_movie) {\n        requestConfig.params.search_field += \" \" + generateCategorySearchString(requestConfig.params.cat_movie);\n      }\n\n      if (requestConfig?.params?.c === \"G\" && requestConfig?.params?.cat_game) {\n        requestConfig.params.search_field += \" \" + generateCategorySearchString(requestConfig.params.cat_game);\n      }\n\n      if (requestConfig?.params?.search_field) {\n        requestConfig.params.search_field = requestConfig.params.search_field.trim();\n      }\n\n      delete requestConfig!.params.cat_movie;\n      delete requestConfig!.params.cat_game;\n\n      return requestConfig!;\n    }"
    },
    "selectors": {
      "rows": {
        "selector": "table#torrent_table > tbody > tr[id]"
      },
      "id": {
        "selector": ":self",
        "attr": "id"
      },
      "title": {
        "selector": [
          "div.name_left > a > b > font",
          "div.name_left > a > b"
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(e: HTMLElement) => e.innerHTML.split(\"<br>\")[0]"
        }
      },
      "subTitle": {
        "selector": [
          "div.name_left > a > b > font",
          "div.name_left > a > b"
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(e: HTMLElement) => extractContent(e.innerHTML.split(\"<br>\")[1] || \"\")"
        }
      },
      "url": {
        "selector": "div.name_left > a",
        "attr": "href"
      },
      "link": {
        "selector": "a.dl_a",
        "attr": "href"
      },
      "time": {
        "selector": "td:nth-child(5)",
        "filters": [
          {
            "name": "parseTime",
            "args": [
              "yyyy-MM-ddHH:mm:ss"
            ]
          }
        ]
      },
      "size": {
        "selector": "td:nth-child(7)"
      },
      "author": {
        "selector": "td:nth-last-child(1)"
      },
      "category": {
        "selector": "td:nth-child(1) > a > img",
        "attr": "alt"
      },
      "seeders": {
        "selector": "td:nth-child(9)",
        "filters": [
          {
            "__fn": true,
            "src": "(q: `${number}/${number}`) => q.split(\"/\")[0]"
          }
        ]
      },
      "leechers": {
        "selector": "td:nth-child(9)",
        "filters": [
          {
            "__fn": true,
            "src": "(q: `${number}/${number}`) => q.split(\"/\")[1]"
          }
        ]
      },
      "completed": {
        "selector": "td:nth-child(8)",
        "filters": [
          {
            "__ref": "parseInt"
          }
        ]
      },
      "comments": {
        "text": 0,
        "selector": "a[href*=\"tocomm=1\"]"
      },
      "tags": [
        {
          "name": "Free",
          "selector": "img[alt='free']",
          "color": "blue"
        },
        {
          "name": "30%",
          "selector": "img[alt='30%']",
          "color": "indigo"
        },
        {
          "name": "50%",
          "selector": "img[alt='50%']",
          "color": "deep-orange-darken-1"
        },
        {
          "name": "Excl.",
          "selector": "span.browse.excl",
          "color": "red"
        }
      ]
    }
  },
  "searchEntry": {
    "area_media": {
      "name": "影视&音乐 Media",
      "requestConfig": {
        "params": {
          "c": "M"
        }
      }
    },
