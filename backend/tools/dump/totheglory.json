  "detail": {
    "urlPattern": [
      "/details.php",
      {
        "__regex": "/\\/t\\/(\\d+)/"
      }
    ],
    "selectors": {
      "id": {
        "selector": "a[tid]",
        "attr": "tid"
      },
      "title": {
        "selector": "h1"
      },
      "link": {
        "selector": "td > a[href*=\"/dl/\"][onclick*=\"copyToClip\"]",
        "attr": "href"
      }
    }
  },
  "userInfo": {
    "pickLast": [
      "id",
      "name"
    ],
    "process": [
      {
        "requestConfig": {
          "url": "/index.php"
        },
        "selectors": {
          "id": {
            "selector": "a[href*='userdetails.php']:first",
            "attr": "href",
            "filters": [
              {
                "name": "querystring",
                "args": [
                  "id"
                ]
              }
            ]
          },
          "name": {
            "selector": "a[href*='userdetails.php']:first"
          }
        }
      },
      {
        "requestConfig": {
          "url": "/userdetails.php"
        },
        "assertion": {
          "id": "params.id"
        },
        "selectors": {
          "messageCount": {
            "selector": "td[style*='background'] > b > a[href*='messages.php'], a[href='#notice']",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "uploaded": {
            "selector": [
              "td.rowhead:contains('上传量') + td",
              "td.rowhead:contains('上傳量') + td"
            ],
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "downloaded": {
            "selector": [
              "td.rowhead:contains('下载量') + td",
              "td.rowhead:contains('下載量') + td"
            ],
            "filters": [
              {
                "name": "parseSize"
              }
            ]
          },
          "ratio": {
            "selector": "td.rowhead:contains('分享率') + td",
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "levelName": {
            "selector": [
              "td.rowhead:contains('等级') + td",
              "td.rowhead:contains('等級') + td"
            ]
          },
          "isDonor": {
            "text": false,
            "selector": [
              "img[alt='Donor']"
            ],
            "elementProcess": {
              "__fn": true,
              "src": "() => true"
            }
          },
          "bonus": {
            "selector": [
              "td.rowhead:contains('积分') + td",
              "td.rowhead:contains('積分') + td"
            ],
            "filters": [
              {
                "name": "parseNumber"
              }
            ]
          },
          "joinTime": {
            "selector": [
              "td.rowhead:contains('注册日期') + td",
              "td.rowhead:contains('註冊日期') + td"
            ],
            "filters": [
              {
                "name": "parseTime"
              }
            ]
          },
          "lastAccessAt": {
            "selector": [
              "td.rowhead:contains('上次访问') + td",
              "td.rowhead:contains('Last seen') + td"
            ],
            "filters": [
              {
                "name": "parseTime"
              }
            ]
          },
          "seeding": {
            "text": 0,
            "selector": "div#ka2",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              const trAnothers = Sizzle(\"tr:not(:eq(0))\", element);\n              return trAnothers.length;\n            }"
            }
          },
          "seedingSize": {
            "text": 0,
            "selector": "div#ka2",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              let seedingSize = 0;\n              const trAnothers = Sizzle(\"tr:not(:eq(0))\", element);\n              trAnothers.forEach((trAnother) => {\n                const sizeAnother = Sizzle(\"td:eq(3)\", trAnother)[0];\n                seedingSize += parseSizeString((sizeAnother as HTMLElement).innerText.trim());\n              });\n              return seedingSize;\n            }"
            }
          },
          "uploads": {
            "text": 0,
            "selector": "div#ka1",
            "elementProcess": {
              "__fn": true,
              "src": "(element: HTMLElement) => {\n              const trAnothers = Sizzle(\"tr:not(:eq(0))\", element);\n              return trAnothers.length;\n            }"
            }
          }
        }
      },
      {
        "requestConfig": {
          "url": "/mybonus.php"
        },
        "selectors": {
          "bonusPerHour": {
            "selector": "td.rowhead:contains('总计') + td",
            "filters": [
              {
                "name": "split",
                "args": [
                  " ",
                  0
                ]
              },
              {
                "name": "parseNumber"
              }
            ]
          }
        }
      }
    ],
    "donorConfig": {
      "isAccountKept": true,
      "bonusPerHourMultiplier": 1
    }
  },
