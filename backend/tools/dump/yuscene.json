{
  "__spread": [
    "SchemaMetadata"
  ],
  "id": "yuscene",
  "version": 1,
  "name": "YUSCENE",
  "aka": [
    "YS"
  ],
  "tags": [
    "综合"
  ],
  "timezoneOffset": "+0000",
  "type": "private",
  "schema": "Unit3D",
  "urls": [
    "https://yu-scene.net/"
  ],
  "favicon": "https://yu-scene.net/favicon.ico",
  "category": [
    {
      "name": "类别",
      "key": "categoryIds",
      "options": {
        "__call": "buildCategoryOptionsFromDict(categoryMap)"
      },
      "cross": {
        "mode": "brackets"
      }
    },
    {
      "__ref": "CategoryFree"
    }
  ],
  "search": {
    "__spread": [
      "SchemaMetadata.search"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.search!.selectors"
      ],
      "category": {
        "selector": ":self",
        "data": "categoryId",
        "filters": [
          {
            "__fn": true,
            "src": "(query: string) => categoryMap[Number(query)]"
          }
        ]
      }
    }
  },
  "userInfo": {
    "__spread": [
      "SchemaMetadata.userInfo!"
    ],
    "selectors": {
      "__spread": [
        "SchemaMetadata.userInfo!.selectors!"
      ],
      "levelName": {
        "selector": [
          "span.user-tag.profile-hero__username a.user-tag__link[title]",
          "main article section:first-of-type div div:nth-child(2) > span > a.user-tag__link[title]",
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.selectors!.levelName?.selector ?? [])"
          }
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(el: Element) => el.getAttribute(\"title\") || el.textContent"
        }
      },
      "joinTime": {
        "selector": [
          "time.profile-hero__meta-item--registration",
          "time.profile-hero__meta-item--registration strong.profile-hero__meta-value",
          "main article section:first-of-type div div:nth-child(2) div time strong.profile-hero__meta-value",
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.selectors!.joinTime?.selector ?? [])"
          }
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(el: Element) => {\n          const timeEl = el.closest(\"time\") ?? el;\n          return parseValidTimeString(\n            timeEl.getAttribute(\"title\") || timeEl.getAttribute(\"datetime\") || el.textContent || \"\",\n          );\n        }"
        }
      },
      "lastAccessAt": {
        "selector": [
          "span.profile-hero__meta-item time[datetime]",
          "main article section:first-of-type div div:nth-child(2) div span:first-of-type time[datetime]",
          {
            "__raw": "SpreadElement",
            "src": "...(SchemaMetadata.userInfo!.selectors!.lastAccessAt?.selector ?? [])"
          }
        ],
        "elementProcess": {
          "__fn": true,
          "src": "(el: Element) => {\n          return parseValidTimeString(el.getAttribute(\"title\") || el.getAttribute(\"datetime\") || el.textContent || \"\");\n        }"
        }
      }
    }
  },
