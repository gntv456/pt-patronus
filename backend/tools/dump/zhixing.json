      "name": "武林高手",
      "bonus": 200
    },
    {
      "id": 5,
      "name": "风尘奇侠",
      "bonus": 500
    },
    {
      "id": 6,
      "name": "无双隐士",
      "bonus": 1000
    },
    {
      "id": 7,
      "name": "世外高人",
