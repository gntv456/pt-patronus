    },
    {
      "key": "timeout_seconds",
      "label": "超时",
      "type": "number",
      "default": 60
    },
    {
      "key": "cron_speedtest",
      "label": "定时",
      "type": "text",
      "default": ""
    },
    {
      "key": "notify",
      "label": "通知结果",
      "type": "switch",
      "default": true
    }
  ],
  "resource_access": {
    "net_hosts": [
      "测速 URL"
    ]
  },
