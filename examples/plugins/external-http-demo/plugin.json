{
  "id": "external-http-demo",
  "name": "外部 HTTP 示例插件",
  "version": "1.0.0",
  "author": "PTPatronus",
  "description": "演示 external-http 插件协议：健康检查、事件接收和动作执行。",
  "runtime": "external-http",
  "entry": {
    "command": "python",
    "args": ["plugin.py"],
    "health": "/health"
  },
  "permissions": ["event:read", "log:write"],
  "events": [
    { "type": "plugin.test", "description": "插件测试事件" }
  ],
  "actions": [
    {
      "name": "ping",
      "label": "Ping",
      "description": "返回插件收到的输入。",
      "input_schema": [
        { "key": "message", "label": "消息", "type": "text", "default": "hello" }
      ]
    }
  ],
  "config_schema": [
    { "key": "prefix", "label": "返回前缀", "type": "text", "default": "pong" }
  ]
}
