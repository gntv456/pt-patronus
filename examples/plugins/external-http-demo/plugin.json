{
  "id": "external-http-demo",
  "name": "External HTTP Demo",
  "version": "1.0.0",
  "api_version": "1",
  "app_version": ">=0.1.0",
  "author": "PTPatronus",
  "description": "Demonstrates the external-http protocol, Host API callbacks, KV storage, events and actions.",
  "license": "MIT",
  "keywords": ["demo", "external-http", "host-api"],
  "runtime": "external-http",
  "entry": {
    "command": "python",
    "args": ["plugin.py"],
    "health": "/health"
  },
  "permissions": [
    "event:read",
    "event:publish",
    "log:write",
    "kv:read",
    "kv:write",
    "config:read"
  ],
  "events": [
    { "type": "plugin.test", "description": "Test event sent from the plugin admin page." }
  ],
  "actions": [
    {
      "name": "ping",
      "label": "Ping",
      "description": "Returns the input and increments a host KV counter.",
      "input_schema": [
        { "key": "message", "label": "Message", "type": "text", "default": "hello" }
      ]
    }
  ],
  "config_schema": [
    { "key": "prefix", "label": "Response prefix", "type": "text", "default": "pong" }
  ],
  "contributes": {
    "commands": [
      {
        "id": "external-http-demo.ping",
        "label": "Ping demo plugin",
        "action": "ping"
      }
    ],
    "menus": [
      {
        "location": "plugins/actions",
        "command": "external-http-demo.ping"
      }
    ],
    "views": [
      {
        "id": "dashboard",
        "title": "External Demo",
        "location": "plugins",
        "path": "index.html"
      }
    ]
  }
}
